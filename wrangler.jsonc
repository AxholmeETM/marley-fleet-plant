// Cloudflare Workers settings. Secrets (DATABASE_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
// ADMIN_EMAIL, ADMIN_PASSWORD) are added in the Cloudflare dashboard, never here. See DEPLOY.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marley-fleet-plant",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node scripts/build-views.js" },
  "assets": { "directory": "./public" },
  // Hyperdrive "marley-db": the connection to Supabase (Workers can't make the encrypted connection themselves).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "c9e8236eba4e4f2db848e9948fee13d8" }],
  "alias": { "@electric-sql/pglite": "./src/no-pglite.js" },
  "vars": { "COOKIE_SECURE": "true" },
  "keep_vars": true,
  "observability": { "enabled": true }
}
