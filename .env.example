# Copy to .env (Node) or .dev.vars (wrangler dev) and fill in. Never commit real values.
# Every setting is explained in docs/ENVIRONMENT.md.

# Database: leave blank to use the built-in database in DATA_DIR
DATABASE_URL=
# DATABASE_SSL=off
# DATABASE_CA=
# DATABASE_POOL=5

# File storage: leave blank to keep files in DATA_DIR/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=receipts

# First admin account (only used when there are no users)
ADMIN_EMAIL=admin@marley.local
ADMIN_PASSWORD=change-me-please

# Sessions
SESSION_SECRET=
COOKIE_SECURE=false
# TRUST_PROXY=1

# Local Node server
PORT=3000
DATA_DIR=./data

# Rules
DEFAULT_SERVICE_SCHEDULE=50, 250, 500
DEFAULT_SERVICE_HOURS=500
DUE_SOON_DAYS=30

# Only for npm run cf:dev (must include a password)
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
