<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Reports</h1><p class="muted" style="margin:0">Each report opens ready to print. Choose <strong>Save as PDF</strong> as the printer to keep a copy.</p></div>
</div>
<%- include('partials/pane-end') %>
<div class="report-grid">
  <% for (const [key, r] of Object.entries(REPORTS)) { if (r.adminOnly && !canEdit) continue; %>
  <div class="card report-card">
    <h2><%= r.label %></h2>
    <p class="muted"><%= r.blurb %></p>
    <% if (r.picker === 'period') { %>
    <form class="report-pick" method="get" action="/reports/<%= key %>" target="_blank">
      <div class="report-dates"><div class="field"><label for="<%= key %>-from">From</label><input id="<%= key %>-from" type="date" name="from"></div><div class="field"><label for="<%= key %>-to">To</label><input id="<%= key %>-to" type="date" name="to"></div></div>
      <p class="hint">Leave blank for the latest SoTrack file uploaded.</p>
      <div class="actions"><button class="btn primary" type="submit" name="print" value="1">Save as PDF</button><button class="btn" type="submit">View</button></div>
    </form>
    <% } else if (r.picker) { %>
    <form class="report-pick" method="get" action="/reports/<%= key %>" target="_blank">
      <input type="search" class="pick-filter" placeholder="Find a name" aria-label="Find a name">
      <div class="pick-list" role="group" aria-label="Employees to include">
        <label class="pick-all"><input type="checkbox" name="person" value="all"> Everyone (one summary table)</label>
        <% for (const p of people) { %><label><input type="checkbox" name="person" value="<%= p.id %>"> <%= p.name %></label><% } %>
      </div>
      <p class="hint pick-count">Tick one or more people. Each gets their own pages with copies of their cards.</p>
      <div class="actions"><button class="btn primary" type="submit" name="print" value="1">Save as PDF</button><button class="btn" type="submit">View</button></div>
    </form>
    <% } else { %>
    <div class="actions"><a class="btn primary" href="/reports/<%= key %>?print=1" target="_blank" rel="noopener">Save as PDF</a><a class="btn" href="/reports/<%= key %>" target="_blank" rel="noopener">View</a></div>
    <% } %>
  </div>
  <% } %>
</div>
<script>
  document.querySelectorAll('.report-pick:has(.pick-list)').forEach((f) => {
    const boxes = [...f.querySelectorAll('input[name=person]')];
    const all = boxes.find((b) => b.value === 'all');
    const count = f.querySelector('.pick-count');
    const update = () => {
      const n = boxes.filter((b) => b.checked && b !== all).length;
      count.textContent = all.checked ? 'Everyone, as one summary table.' : n ? `${n} ${n === 1 ? 'person' : 'people'} chosen.` : 'Tick one or more people. Each gets their own pages with copies of their cards.';
    };
    f.addEventListener('change', (e) => {
      if (e.target === all && all.checked) boxes.forEach((b) => { if (b !== all) b.checked = false; });
      else if (e.target.name === 'person' && e.target.checked) all.checked = false;
      update();
    });
    f.querySelector('.pick-filter').addEventListener('input', (e) => {
      const q = e.target.value.trim().toLowerCase();
      boxes.forEach((b) => { if (b !== all) b.parentElement.hidden = q && !b.parentElement.textContent.toLowerCase().includes(q); });
    });
    f.addEventListener('submit', (e) => { if (!boxes.some((b) => b.checked)) { e.preventDefault(); count.textContent = 'Tick at least one person first.'; } });
  });
</script>
<%- include('partials/footer') %>
