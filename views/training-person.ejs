<%- include('partials/header') %>
<div class="page-head">
  <div><h1><%= p.name %></h1><p class="muted" style="margin:0"><%= userLabel(p) %><%= p.job_title ? ' · ' + p.job_title : '' %></p></div>
  <div class="actions"><a class="btn" href="/users/<%= p.id %>">Employee details</a></div>
</div>
<%- include('partials/pane-end') %>
<% if (onboard) { %>
<div class="card tp-onboard">
  <h2>Set up <%= p.name %>'s training</h2>
  <p>Tick <strong>Needs this</strong> for each course they have to do, and enter the expiry date for any card or course they already hold. You can change this at any time from the Training Matrix.</p>
</div>
<% } else { %>
<% const lv = [...recs.values()].map((r) => r.status && r.status.level).filter(Boolean);
   const n = (l) => lv.filter((x) => x === l).length; %>
<div class="kpis kpis-4 tp-kpis">
  <button type="button" class="kpi <%= n('soon') ? 'warn' : 'good' %>" data-show="soon"><div class="label">Expiring in 30 days</div><div class="value"><%= n('soon') %></div></button>
  <button type="button" class="kpi <%= n('overdue') ? 'bad' : 'good' %>" data-show="overdue"><div class="label">Expired</div><div class="value"><%= n('overdue') %></div></button>
  <button type="button" class="kpi <%= n('needed') ? 'warn' : 'good' %>" data-show="needed"><div class="label">Needed</div><div class="value"><%= n('needed') %></div></button>
  <button type="button" class="kpi plain" data-show="ok soon"><div class="label">Qualifications held</div><div class="value"><%= n('ok') + n('soon') %></div></button>
</div>
<% } %>
<form class="card" method="post" action="/training/people/<%= p.id %>">
  <% if (onboard) { %><input type="hidden" name="onboard" value="1"><% } %>
  <div class="tp-fields">
    <div class="field"><span class="label">Training paid for</span>
      <div class="seg funded" role="radiogroup" aria-label="Training paid for"><% for (const v of ['Company', 'Personal']) { %><input type="radio" id="funded_<%= v %>" name="training_funded" value="<%= v %>" <%= p.training_funded === v ? 'checked' : '' %>><label for="funded_<%= v %>"><%= v %></label><% } %></div></div>
  </div>
  <% for (const g of GROUPS) { const list = courses.filter((c) => c.grp === g); if (!list.length) continue;
    const st = list.map((c) => recs.get(c.id)).filter((r) => r && r.status).map((r) => r.status.level);
    const count = (l) => st.filter((x) => x === l).length; %>
  <details class="tp-group g<%= GROUPS.indexOf(g) %>"<%= onboard ? ' open' : '' %>>
  <summary><span class="tp-name"><%= g %></span><span class="tp-sum"><%= st.filter((x) => ['ok', 'soon'].includes(x)).length %> held<% if (count('soon')) { %> · <span class="pill soon"><%= count('soon') %> within 30 days</span><% } %><% if (count('overdue')) { %> · <span class="pill overdue"><%= count('overdue') %> expired</span><% } %></span><span class="chev" aria-hidden="true"></span></summary>
  <div class="table-wrap"><table class="tp-table">
    <% const scheme = cardScheme(g); %>
    <thead><tr><th>Training</th><% if (scheme || g === 'General') { %><th>Card</th><% } %><th>Expiry date</th><th>Note</th><th>Needs this</th><th>Status</th></tr></thead>
    <tbody><% for (const c of list) { const r = recs.get(c.id) || {}; %>
      <tr data-level="<%= r.status ? r.status.level : '' %>">
        <td><%= c.name %><% if (c.code) { %><div class="tp-code"><span class="code-tag"><%= c.code %></span><% } %><% if (c.info) { %> <button type="button" class="info-btn" aria-label="What is <%= c.name %>?" data-t="<%= g %> · <%= c.name %><%= c.code ? ' · ' + c.code : '' %>" data-b="<%= c.info %>">i</button><% } %><% if (c.code) { %></div><% } %></td>
        <% if (g === 'General') { %><td><% if (c.key === 'cscs') { %>
      <div class="cscs-pick"><span class="cscs cscs-<%= CSCS_CARDS[p.cscs_card] ? CSCS_CARDS[p.cscs_card].colour : 'none' %>" id="cscs-swatch"></span>
      <select id="cscs_card" name="cscs_card" aria-label="CSCS card"><option value="">Not recorded</option><% for (const [k, cc] of Object.entries(CSCS_CARDS)) { %><option value="<%= k %>" data-colour="<%= cc.colour %>" <%= p.cscs_card === k ? 'selected' : '' %>><%= cscsLabel(k) %></option><% } %></select></div>
      <% if (CSCS_CARDS[p.cscs_card] && !CSCS_CARDS[p.cscs_card].renew) { %><p class="hint">This card can't be renewed. They'll need to qualify for another card before it runs out.</p><% } %>
        <% } %></td><% } %>
        <% if (scheme) { %><td><div class="card-ticks small" role="radiogroup" aria-label="<%= c.name %> card"><input type="radio" id="card_<%= c.id %>_" name="card_<%= c.id %>" value="" <%= !PLANT_CARDS[scheme][r.card] ? 'checked' : '' %>><label for="card_<%= c.id %>_" title="Not recorded">None</label><% for (const [k, cc] of Object.entries(PLANT_CARDS[scheme])) { %><input type="radio" id="card_<%= c.id %>_<%= k %>" name="card_<%= c.id %>" value="<%= k %>" <%= r.card === k ? 'checked' : '' %>><label for="card_<%= c.id %>_<%= k %>" title="<%= cc.label %> · <%= cc.name %>"><span class="cscs cscs-<%= cc.colour %>"></span><%= cc.label %></label><% } %></div></td><% } %>
        <td><input type="date" name="expiry_<%= c.id %>" value="<%= r.expiry || '' %>" aria-label="<%= c.name %> expiry"></td>
        <td><input type="text" name="note_<%= c.id %>" value="<%= r.note || '' %>" maxlength="80" aria-label="<%= c.name %> note" placeholder="e.g. Booked 19/10/26"></td>
        <td><input type="checkbox" name="required_<%= c.id %>" value="1" <%= r.required ? 'checked' : '' %> aria-label="<%= c.name %> needed"></td>
        <td><%- r.status ? pill({ level: r.status.level === 'needed' || r.status.level === 'note' ? 'none' : r.status.level, text: r.status.text }) : '' %></td>
      </tr>
    <% } %></tbody>
  </table></div>
  </details>
  <% } %>
  <div class="actions" style="margin-top:16px"><% if (onboard) { %><a class="btn" href="/users/<%= p.id %>">Skip for now</a><% } %><button class="btn primary" type="submit"><%= onboard ? 'Save and finish' : 'Save training' %></button></div>
</form>
<script>
  // A card opens the groups holding those items and highlights them.
  document.querySelectorAll('.tp-kpis [data-show]').forEach((b) => b.addEventListener('click', () => {
    const levels = b.dataset.show.split(' ');
    document.querySelectorAll('tr.tp-hit').forEach((tr) => tr.classList.remove('tp-hit'));
    const rows = [...document.querySelectorAll('tr[data-level]')].filter((tr) => levels.includes(tr.dataset.level));
    document.querySelectorAll('details.tp-group').forEach((d) => { d.open = rows.some((tr) => d.contains(tr)); });
    rows.forEach((tr) => tr.classList.add('tp-hit'));
    if (rows[0]) rows[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
  }));
</script>
<script>
  for (const id of ['cscs_card']) {
    document.getElementById(id).addEventListener('change', (e) => {
      const o = e.target.selectedOptions[0];
      document.getElementById(id.replace('_card', '-swatch')).className = 'cscs cscs-' + (o.dataset.colour || 'none');
    });
  }
</script>
<%- include('partials/person-docs') %>
<%- include('partials/course-info') %>
<%- include('partials/footer') %>
