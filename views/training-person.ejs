<%- include('partials/header') %>
<div class="page-head">
  <div><h1><%= p.name %></h1><p class="muted" style="margin:0"><%= userLabel(p) %><%= p.job_title ? ' · ' + p.job_title : '' %></p></div>
  <div class="actions"><a class="btn" href="/users/<%= p.id %>">Employee details</a></div>
</div>
<%- include('partials/pane-end') %>
<form class="card" method="post" action="/training/people/<%= p.id %>">
  <div class="grid-2">
    <div class="field"><label for="training_funded">Training paid for</label><input type="text" id="training_funded" name="training_funded" value="<%= p.training_funded || '' %>" maxlength="80" placeholder="e.g. Y, or CPCS"></div>
    <div class="field"><label for="training_note">Note</label><input type="text" id="training_note" name="training_note" value="<%= p.training_note || '' %>" maxlength="200"></div>
  </div>
  <% for (const g of GROUPS) { const list = courses.filter((c) => c.grp === g); if (!list.length) continue; %>
  <h2><%= g %></h2>
  <div class="table-wrap"><table class="tp-table">
    <thead><tr><th>Training</th><th>Expiry date</th><th>Note</th><th>Needed</th><th>Status</th></tr></thead>
    <tbody><% for (const c of list) { const r = recs.get(c.id) || {}; %>
      <tr>
        <td><%= c.name %></td>
        <td><input type="date" name="expiry_<%= c.id %>" value="<%= r.expiry || '' %>" aria-label="<%= c.name %> expiry"></td>
        <td><input type="text" name="note_<%= c.id %>" value="<%= r.note || '' %>" maxlength="80" aria-label="<%= c.name %> note" placeholder="e.g. Booked 19/10/26"></td>
        <td><input type="checkbox" name="required_<%= c.id %>" value="1" <%= r.required ? 'checked' : '' %> aria-label="<%= c.name %> needed"></td>
        <td><%- r.status ? pill({ level: r.status.level === 'needed' || r.status.level === 'note' ? 'none' : r.status.level, text: r.status.text }) : '' %></td>
      </tr>
    <% } %></tbody>
  </table></div>
  <% } %>
  <div class="actions" style="margin-top:16px"><button class="btn primary" type="submit">Save training</button></div>
</form>
<form method="post" action="/training/people/<%= p.id %>/remove" onsubmit="return confirm('Take <%= p.name.replace(/'/g, '') %> off the Training Matrix? Their dates are kept.')">
  <button class="btn danger" type="submit">Take off the matrix</button>
</form>
<%- include('partials/footer') %>
