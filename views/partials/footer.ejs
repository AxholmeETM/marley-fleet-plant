</main>
</div>
</div>
<script>
// How tall the fixed top pane is, so list headings can stick just below it.
(function () {
  const pane = document.querySelector('.pane');
  const set = () => document.documentElement.style.setProperty('--pane-h', (pane ? pane.offsetHeight : 0) + 'px');
  set(); addEventListener('resize', set);
})();
// Filter bars update the list as soon as a choice changes; the search box waits for a pause in typing.
document.querySelectorAll('form.filters').forEach((form) => {
  const go = () => form.requestSubmit ? form.requestSubmit() : form.submit();
  let timer;
  // Leave empty choices out of the address so it stays short.
  form.addEventListener('submit', () => form.querySelectorAll('input, select').forEach((el) => { if (!el.value) el.disabled = true; }));
  form.addEventListener('change', (e) => {
    if (e.target.type === 'search') return;
    if (e.target.name === 'period' && e.target.value === 'custom') return; // wait for the dates
    go();
  });
  form.addEventListener('input', (e) => {
    if (e.target.type !== 'search') return;
    clearTimeout(timer);
    timer = setTimeout(go, 600);
  });
  // After a search reloads the page, carry on typing where you left off.
  const q = form.querySelector('input[type=search]');
  if (q && q.value && new URLSearchParams(location.search).has(q.name)) { q.focus(); q.setSelectionRange(q.value.length, q.value.length); }
});
<% if (isManager) { %>
// Managers can look at everything but not change it: forms are shown read-only and add or edit links are hidden.
document.querySelectorAll('form[method="post"]:not(.keep)').forEach((form) => {
  form.querySelectorAll('input, select, textarea').forEach((el) => { el.disabled = true; });
  form.querySelectorAll('button[type="submit"], input[type="file"]').forEach((el) => { (el.closest('.field') || el).style.display = 'none'; });
  if (!form.querySelector('input:not([type="hidden"]):not([type="file"]), select, textarea')) form.style.display = 'none';
  if (form.matches('.assign-add, .filters')) form.style.display = 'none';
});
document.querySelectorAll('a[href$="/new"], a[href*="/new?"], a[href$="/edit"], [data-open="record-dlg"]').forEach((el) => {
  if (!el.closest('.side-nav')) el.style.display = 'none';
});
<% } %>
<% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
// Breadcrumbs follow the way you came: a link from one section to a page in another carries ?from=<this page>.
(function () {
  const DETAIL = /^\/(users|vehicles|plant|projects|training\/people|checks\/(plant|vehicle))\/[^/]+$/;
  const section = (p) => { const s = p.split('/')[1] || ''; return s === 'calendar' ? '' : s === 'equipment' ? 'plant' : s; };
  document.addEventListener('click', function (e) {
    const a = e.target.closest && e.target.closest('a[href]');
    if (!a || a.closest('.crumbs, .side-nav, .subnav') || a.origin !== location.origin) return;
    if (!DETAIL.test(a.pathname) || /\/new$/.test(a.pathname)) return;
    if (section(a.pathname) === section(location.pathname)) return;
    const here = new URL(location.href);
    here.searchParams.delete('from');
    const url = new URL(a.href);
    url.searchParams.set('from', here.pathname + here.search);
    a.href = url.pathname + url.search + url.hash;
  }, true);
})();
<% } %>
</script>
</body>
</html>
