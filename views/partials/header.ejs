<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Marley Fleet &amp; Plant</title>
  <link rel="stylesheet" href="/static/style.css">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#01024c">
</head>
<body>
<div class="layout">
<aside class="sidebar">
  <a class="brand with-logo" href="/"><img class="brand-logo" src="/static/logo.png" alt="Marley"><span>Marley Construction Ltd</span></a>
    <nav class="side-nav" aria-label="Main menu">
      <%
        // [href, label, other paths that belong to the same section]; admins get headings that open to show their pages.
        const cameFrom = typeof origin !== 'undefined' && origin ? origin : null;
        const menu = isAdmin
          ? [['/', 'Dashboard', ['/calendar']],
            { label: 'Registers', items: [['/plant', 'Plant', ['/checks', '/defects']], ['/vehicles', 'Fleet'], ['/equipment', 'Equipment']] },
            { label: 'Fuel', items: [['/fuel', 'Fuel Logs'], ['/fuel-cards', 'Fuel Cards']] },
            ['/mileage', 'Mileage'],
            ['/users', 'Employees'],
            ...(canEdit ? [['/training', 'Training Matrix']] : []),
            { label: 'Admin', items: [['/projects', 'Projects'], ['/reports', 'Reports']] }]
          : user.employee_type === 'site_manager'
            ? [['/', 'Dashboard', ['/calendar']], ['/plant', 'Plant'], ['/equipment', 'Equipment'], ['/checks/plant/new', 'Plant check'], ['/checks/vehicle/new', 'Walk-around'], ['/fuel/new', 'Log fuel'], ['/defects/new', 'Report defect']]
            : [['/', 'Home'], ['/checks/vehicle/new', 'Walk-around'], ['/fuel/new', 'Log fuel'], ['/defects/new', 'Report defect']];
        const nav = menu.flatMap((m) => m.items || [m]);
        const under = (base) => path === base || path.startsWith(base + '/');
        const isActive = ([href, , also = []]) => {
          if (cameFrom) return cameFrom.nav === href;
          if (typeof navActive !== 'undefined') return navActive === href;
          if (href === '/') return path === '/' || also.includes(path);
          if (isAdmin || href === '/plant' || href === '/equipment') return [href, ...also].some(under);
          return path === href;
        };
        const current = nav.find(isActive);
        for (const m of menu) {
          if (!m.items) { %>
        <a href="<%= m[0] %>" class="<%= m === current ? 'active' : '' %>"><%= m[1] %></a>
      <%  } else { const open = m.items.includes(current); %>
        <div class="nav-group<%= open ? ' open' : '' %>">
          <button type="button" class="nav-head" aria-expanded="<%= open %>"><%= m.label %><span class="chev" aria-hidden="true"></span></button>
          <div class="nav-items"><% for (const item of m.items) { %><a href="<%= item[0] %>" class="<%= item === current ? 'active' : '' %>"><%= item[1] %></a><% } %></div>
        </div>
      <%  }
        } %>
    </nav>
    <script>
      document.querySelectorAll('.nav-head').forEach((b) => b.addEventListener('click', () => {
        b.setAttribute('aria-expanded', b.parentElement.classList.toggle('open'));
      }));
    </script>
    <div class="side-user">
      <a href="/account" class="who"><%= user.name %></a>
      <form method="post" action="/logout" class="keep"><button class="linkbtn" type="submit">Sign out</button></form>
    </div>
</aside>
<div class="content">
<div class="pane"><div class="pane-inner">
<%
  // Second-level tabs for the sections that hold more than one page.
  const SUBNAV = {
    '/': [['/', 'Dashboard', (p) => p === '/'], ['/calendar', 'Calendar', (p) => p === '/calendar']],
    '/plant': [['/plant', 'Plant', (p) => p === '/plant'], ['/checks?type=plant', 'Site Checks', (p) => p.startsWith('/checks')], ['/defects', 'Defects', (p) => p.startsWith('/defects')]],
    '/mileage': [['/mileage', 'Dashboard', (p) => p === '/mileage'], ['/mileage/drivers', 'Drivers', (p) => p === '/mileage/drivers']],
    '/fuel': [['/fuel', 'Summary', (p) => p === '/fuel'], ['/fuel/log', 'Fuel log and receipts', (p) => p === '/fuel/log']],
    '/training': [['/training', 'Dashboard', (p) => p === '/training'], ['/training/matrix', 'Training Matrix', (p) => p === '/training/matrix']],
  };
  const subnav = !crumbs && current && (isAdmin ? SUBNAV[current[0]] : user.employee_type === 'site_manager' && current[0] === '/' && SUBNAV['/']);
  // Opened from another page (?from=): lead back through that page, then this one.
  const trail = crumbs && cameFrom ? [...cameFrom.trail, [typeof crumbHere !== 'undefined' ? crumbHere : crumbs[crumbs.length - 1][0]]] : crumbs;
  if (trail) { %>
<nav class="crumbs" aria-label="Breadcrumb"><% trail.forEach(([label, href], i) => { %><%- i ? '<span class="sep">›</span>' : '' %><% if (href) { %><a href="<%= href %>"><%= label %></a><% } else { %><span aria-current="page"><%= label %></span><% } %><% }) %></nav>
<% } else if (subnav) { %>
<nav class="subnav"><% for (const [href, label, on] of subnav) { %><a href="<%= href %>" class="<%= on(path) ? 'active' : '' %>"><%= label %></a><% } %></nav>
<% } %>
