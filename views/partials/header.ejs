<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Marley Fleet &amp; Plant</title>
  <link rel="stylesheet" href="/static/style.css">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#0b1f3f">
</head>
<body>
<div class="layout">
<aside class="sidebar">
  <a class="brand" href="/"><span class="brand-mark">M</span><span>Marley Construction<small>Fleet &amp; Plant Register</small></span></a>
    <nav class="side-nav" aria-label="Main menu">
      <%
        // [href, label, other paths that belong to the same section]
        const nav = isAdmin
          ? [['/', 'Dashboard'], ['/plant', 'Plant'], ['/vehicles', 'Fleet'], ['/fuel-cards', 'Fuel cards', ['/fuel']], ['/equipment', 'Equipment'], ['/admin', 'Admin', ['/users', '/checks', '/defects', '/projects']]]
          : user.employee_type === 'site_manager'
            ? [['/', 'Home'], ['/plant', 'Plant'], ['/equipment', 'Equipment'], ['/checks/plant/new', 'Plant check'], ['/checks/vehicle/new', 'Walk-around'], ['/fuel/new', 'Log fuel'], ['/defects/new', 'Report defect']]
            : [['/', 'Home'], ['/checks/vehicle/new', 'Walk-around'], ['/fuel/new', 'Log fuel'], ['/defects/new', 'Report defect']];
        const under = (base) => path === base || path.startsWith(base + '/');
        const isActive = ([href, , also = []]) => {
          if (typeof navActive !== 'undefined') return navActive === href;
          if (href === '/') return path === '/';
          if (isAdmin || href === '/plant' || href === '/equipment') return [href, ...also].some(under);
          return path === href;
        };
        const current = nav.find(isActive);
        for (const item of nav) { %>
        <a href="<%= item[0] %>" class="<%= item === current ? 'active' : '' %>"><%= item[1] %></a>
      <% } %>
    </nav>
    <div class="side-user">
      <a href="/account" class="who"><%= user.name %></a>
      <form method="post" action="/logout"><button class="linkbtn" type="submit">Sign out</button></form>
    </div>
</aside>
<div class="content">
<div class="pane"><div class="pane-inner">
<%
  // Second-level tabs for the sections that hold more than one page.
  const SUBNAV = {
    '/fuel-cards': [['/fuel', 'Fuel log & receipts', (p) => p === '/fuel' || /^\/fuel\/(\d+|next)$/.test(p)], ['/fuel-cards', 'Cards', (p) => p === '/fuel-cards' || /^\/fuel-cards\/(new|\d+)/.test(p)], ['/fuel-cards/assign', 'Assign cards to people', (p) => p === '/fuel-cards/assign']],
    '/admin': [['/admin', 'Overview', (p) => p === '/admin'], ['/users', 'Users', (p) => p.startsWith('/users')], ['/checks', 'Checks', (p) => p.startsWith('/checks')], ['/defects', 'Defects', (p) => p.startsWith('/defects')], ['/projects', 'Projects', (p) => p.startsWith('/projects')]],
  };
  // The Admin overview's tiles already link to its tabs, so the tabs start on the pages below it.
  const subnav = !crumbs && isAdmin && current && path !== '/admin' && SUBNAV[current[0]];
  if (crumbs) { %>
<nav class="crumbs" aria-label="Breadcrumb"><% crumbs.forEach(([label, href], i) => { %><%- i ? '<span class="sep">›</span>' : '' %><% if (href) { %><a href="<%= href %>"><%= label %></a><% } else { %><span aria-current="page"><%= label %></span><% } %><% }) %></nav>
<% } else if (subnav) { %>
<nav class="subnav"><% for (const [href, label, on] of subnav) { %><a href="<%= href %>" class="<%= on(path) ? 'active' : '' %>"><%= label %></a><% } %></nav>
<% } %>
