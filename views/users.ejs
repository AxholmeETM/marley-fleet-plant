<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Employees</h1><p class="muted" style="margin:0">Everyone at Marley, with their vehicles and fuel cards. Only people with an email and password can sign in.</p></div>
  <div class="actions"><a class="btn primary" href="/users/new">Add employee</a></div>
</div>
<form class="filters" method="get">
  <div class="field"><label for="show">Type</label>
    <select id="show" name="show">
      <% for (const [key, label, n] of [['', 'Everyone', counts.all_users], ['drivers', 'Fleet drivers', counts.drivers], ['site_managers', 'Site managers', counts.site_managers], ['workers', 'Site workers', counts.workers], ['admins', 'Admin users', counts.admins]]) { %>
        <option value="<%= key %>" <%= show === key ? 'selected' : '' %>><%= label %> (<%= n || 0 %>)</option>
      <% } %>
    </select></div>
  <a class="btn" href="<%= path %>">Reset</a>
</form>
<%- include('partials/pane-end') %>
<div class="card flush">
  <% if (!users.length) { %><p class="empty">Nobody here yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Name</th><th>Employee ID</th><th>Type</th><th>Job role</th><th>Email / phone</th><th>Vehicles</th><th class="num">Fuel cards</th><th>Status</th><th></th></tr></thead>
    <tbody><% for (const u of users) { %>
      <tr>
        <td><a href="/users/<%= u.id %>"><strong><%= u.name %></strong></a></td>
        <td><%= u.employee_no || '—' %></td>
        <td><span class="pill et et-<%= u.role === 'admin' ? 'admin' : u.employee_type || 'none' %>"><%= userLabel(u) %></span></td>
        <td><%= u.job_title || '—' %></td>
        <td><%= u.email || '—' %><% if (!u.password_hash) { %> <span class="small muted">· No login</span><% } %><% if (u.phone) { %><div class="small muted"><%= u.phone %></div><% } %></td>
        <td><%= u.vehicles || '—' %></td>
        <td class="num"><%= u.cards ? u.cards : '—' %></td>
        <td><%- u.active ? '<span class="pill ok">Active</span>' : '<span class="pill none">Disabled</span>' %></td>
        <td><a href="/users/<%= u.id %>">View</a></td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<%- include('partials/footer') %>
