<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Users</h1><p class="muted" style="margin:0">Admin users run the office side and see everything. Employees (fleet drivers and site managers) do checks, log fuel and report defects.</p></div>
  <div class="actions"><a class="btn" href="/users/new?role=admin">Add admin user</a><a class="btn primary" href="/users/new">Add employee</a></div>
</div>
<form class="filters" method="get">
  <div class="field"><label for="show">Type</label>
    <select id="show" name="show">
      <% for (const [key, label, n] of [['', 'Everyone', counts.all_users], ['employees', 'Employees', counts.employees], ['drivers', 'Fleet drivers', counts.drivers], ['site_managers', 'Site managers', counts.site_managers], ['admins', 'Admin users', counts.admins]]) { %>
        <option value="<%= key %>" <%= show === key ? 'selected' : '' %>><%= label %> (<%= n || 0 %>)</option>
      <% } %>
    </select></div>
  <button class="btn" type="submit">Apply</button>
</form>
<div class="card flush">
  <% if (!users.length) { %><p class="empty">Nobody here yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Name</th><th>Type</th><th>Job role</th><th>Email / phone</th><th>Vehicles</th><th class="num">Fuel cards</th><th>Status</th><th></th></tr></thead>
    <tbody><% for (const u of users) { %>
      <tr>
        <td><strong><%= u.name %></strong></td>
        <td><span class="pill <%= u.role === 'admin' ? 'soon' : 'none' %>"><%= userLabel(u) %></span></td>
        <td><%= u.job_title || '—' %></td>
        <td><%= u.email %><% if (u.phone) { %><div class="small muted"><%= u.phone %></div><% } %></td>
        <td><%= u.vehicles || '—' %></td>
        <td class="num"><%= u.cards ? u.cards : '—' %></td>
        <td><%- u.active ? '<span class="pill ok">Active</span>' : '<span class="pill none">Disabled</span>' %></td>
        <td><a href="/users/<%= u.id %>/edit">Edit</a></td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<%- include('partials/footer') %>
