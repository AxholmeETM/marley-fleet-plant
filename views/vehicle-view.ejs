<%- include('partials/header') %>
<div class="page-head">
  <div><h1><span class="reg" style="font-size:1.4rem"><%= item.reg %></span> <span style="font-weight:400"><%= [item.make, item.model].filter(Boolean).join(' ') %></span></h1>
    <p class="muted" style="margin:0"><%= [item.asset_no, VEHICLE_CATEGORIES[item.category], OWNERS[item.owner], item.colour, item.vehicle_type, FUEL_LABELS[item.fuel_type]].filter(Boolean).join(' · ') %> · User: <%= item.driver_display || 'none' %>
      <% if (item.status !== 'active') { %> · <span class="pill none"><%= VEHICLE_STATUSES[item.status] %></span><% } %></p></div>
  <div class="actions">
    <a class="btn" href="/checks/vehicle/new?vehicle=<%= item.id %>">New walk-around</a>
    <a class="btn" href="/fuel/new?vehicle=<%= item.id %>">Log fuel</a>
    <% if (isAdmin) { %><a class="btn primary" href="/vehicles/<%= item.id %>/edit">Edit</a><% } else { %><a class="btn" href="/defects/new?asset=vehicle:<%= item.id %>">Report defect</a><% } %>
  </div>
</div>
<% const cls = (s) => ({ overdue: 'bad', soon: 'warn', ok: 'good' }[s.level] || ''); %>
<div class="kpis">
  <div class="kpi <%= cls(item.walkaround) %>"><div class="label">Today's walk-around</div><div class="value" style="font-size:1.3rem"><%= item.walkaround.level === 'ok' ? 'Done' : 'Not done' %></div><div class="sub"><%- pill(item.walkaround) %></div></div>
  <div class="kpi <%= cls(item.service) %>"><div class="label">Last service</div><div class="value" style="font-size:1.3rem"><%= ukDate(item.last_service_date) %></div><div class="sub">Next: <%- pill(item.service) %></div></div>
  <div class="kpi <%= cls(item.mot) %>"><div class="label">MOT expiry</div><div class="value" style="font-size:1.3rem"><%= ukDate(item.mot_due) %></div><div class="sub"><%- pill(item.mot) %></div></div>
  <div class="kpi <%= cls(item.tax) %>"><div class="label">Tax expiry</div><div class="value" style="font-size:1.3rem"><%= ukDate(item.tax_due) %></div><div class="sub"><%- pill(item.tax) %></div></div>
  <div class="kpi"><div class="label">Mileage</div><div class="value" style="font-size:1.3rem"><%= num(item.mileage) %></div><div class="sub">latest logged</div></div>
</div>

<div class="grid grid-2">
  <div>
    <div class="card">
      <h2>Details</h2>
      <dl class="facts">
        <dt>Tracked</dt><dd><%= TRACKED[item.tracked] || 'Not known' %></dd>
        <dt>Driver app account</dt><dd><%= item.driver_name || 'None – walk-arounds not expected' %></dd>
        <% if (isAdmin) { %><dt>Purchased</dt><dd><%= ukDate(item.purchase_date) %><%= item.purchase_price != null ? ' · ' + money(item.purchase_price) : '' %></dd><% } %>
        <dt>Fuel cards</dt><dd><% if (!cards.length) { %>None linked<% if (isAdmin) { %> · <a href="/fuel-cards/new?vehicle=<%= item.id %>">Add</a><% } %><% } else { for (const c of cards) { const label = `${c.provider}${c.card_ref ? ' #' + c.card_ref : ''}${c.last4 ? ' ••' + c.last4 : ''}`; %>
          <div><% if (isAdmin) { %><a href="/fuel-cards/<%= c.id %>/edit"><%= label %></a><% } else { %><%= label %><% } %> <span class="pill <%= c.status === 'active' ? 'ok' : 'none' %>"><%= FUEL_CARD_STATUSES[c.status] %></span></div>
        <% } } %></dd>
      </dl>
    </div>
    <div class="card flush">
      <h2>Walk-around checks</h2>
      <% if (!checks.length) { %><p class="empty">No walk-around checks yet.</p><% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>Driver</th><th class="num">Mileage</th><th>Result</th></tr></thead>
        <tbody><% for (const c of checks) { %>
          <tr><td><a href="/checks/vehicle/<%= c.id %>"><%= ukDate(c.check_date) %></a></td><td><%= c.user_name %></td><td class="num"><%= num(c.mileage) %></td>
            <td><%- c.defects_found ? `<span class="pill overdue">${c.defects_found} defect${c.defects_found > 1 ? 's' : ''}</span>` : '<span class="pill ok">All OK</span>' %></td></tr>
        <% } %></tbody>
      </table></div><% } %>
    </div>
    <div class="card flush">
      <h2>Fuel</h2>
      <% if (!fuel.length) { %><p class="empty">No fuel logged.</p><% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>Driver</th><th>Fuel</th><th class="num">Litres</th><th class="num">Cost</th><th></th></tr></thead>
        <tbody><% for (const f of fuel) { %>
          <tr><td><%= ukDate(f.fill_date) %></td><td><%= f.driver_name %></td><td><%= FUEL_LABELS[f.fuel_type] %></td><td class="num"><%= num(f.litres, 2) %></td><td class="num"><%= money(f.cost) %></td><td><a href="<%= isAdmin ? '/fuel/' + f.id : '/receipts/' + f.receipt_file %>">Receipt</a></td></tr>
        <% } %></tbody>
      </table></div><% } %>
    </div>
  </div>
  <div>
    <% if (isAdmin) { %>
    <form class="card" method="post" action="/vehicles/<%= item.id %>/records">
      <h2>Record a service, MOT or tax renewal</h2>
      <div class="form-grid">
        <div class="field"><label for="kind">Type</label>
          <select id="kind" name="kind"><option value="service">Service</option><option value="mot">MOT pass</option><option value="tax">Tax renewed</option><option value="repair">Repair</option></select></div>
        <div class="field"><label for="record_date">Date</label><input id="record_date" name="record_date" type="date" value="<%= today %>" max="<%= today %>" required></div>
        <div class="field" id="next-due-field"><label for="next_due">New expiry date <span class="hint" id="next-hint">(MOT: defaults to 1 year)</span></label><input id="next_due" name="next_due" type="date"></div>
        <div class="field"><label for="reading">Mileage</label><input id="reading" name="reading" type="number" min="0" step="1"></div>
        <div class="field"><label for="done_by">Done by</label><input id="done_by" name="done_by" type="text" placeholder="Garage"></div>
      </div>
      <div class="field"><label for="rnotes">Notes</label><input id="rnotes" name="notes" type="text"></div>
      <button class="btn dark" type="submit">Save record</button>
    </form>
    <% } %>
    <div class="card flush">
      <h2>History</h2>
      <% if (!records.length) { %><p class="empty">No service, MOT or tax records yet.</p><% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>Type</th><th>Expiry</th><th class="num">Mileage</th><th>Notes</th></tr></thead>
        <tbody><% for (const r of records) { %>
          <tr><td><%= ukDate(r.record_date) %></td><td><%= { service: 'Service', mot: 'MOT', tax: 'Tax', repair: 'Repair' }[r.kind] %></td><td><%= ukDate(r.next_due) %></td><td class="num"><%= num(r.reading) %></td><td><%= [r.done_by, r.notes].filter(Boolean).join(' · ') || '—' %></td></tr>
        <% } %></tbody>
      </table></div><% } %>
    </div>
    <div class="card flush">
      <h2>Defects</h2>
      <% if (!defects.length) { %><p class="empty">No defects reported.</p><% } else { %>
      <div class="table-wrap"><table><tbody><% for (const d of defects) { %>
        <tr><td class="nowrap"><%= ukDate(d.reported_at) %></td><td><%= d.description %><div class="small muted"><%= d.reported_by_name %><%= d.status === 'resolved' ? ' · Fixed: ' + (d.resolution || '') : '' %></div></td>
          <td><% if (d.status === 'open') { %><span class="pill <%= d.severity %>"><%= SEVERITY_LABELS[d.severity] %></span><% } else { %><span class="pill ok">Resolved</span><% } %></td></tr>
      <% } %></tbody></table></div>
      <% if (isAdmin) { %><p class="empty" style="padding-top:8px"><a href="/defects?asset=vehicle">Manage defects →</a></p><% } %><% } %>
    </div>
    <% if (item.notes) { %><div class="card"><h2>Notes</h2><p style="white-space:pre-wrap;margin:0"><%= item.notes %></p></div><% } %>
  </div>
</div>
<script>
  (function () {
    if (!document.getElementById('kind')) return;
    const kind = document.getElementById('kind'), field = document.getElementById('next-due-field'), input = document.getElementById('next_due'), hint = document.getElementById('next-hint');
    function upd() {
      field.style.display = kind.value === 'mot' || kind.value === 'tax' ? '' : 'none';
      input.required = kind.value === 'tax';
      hint.textContent = kind.value === 'mot' ? '(defaults to 1 year)' : '(required)';
    }
    kind.addEventListener('change', upd); upd();
  })();
</script>
<%- include('partials/footer') %>
