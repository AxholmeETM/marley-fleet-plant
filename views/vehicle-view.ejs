<%- include('partials/header') %>
<div class="page-head">
  <div><h1><span class="reg"><%= item.reg %></span> <span style="font-weight:400"><%= [item.make, item.model].filter(Boolean).join(' ') %></span></h1></div>
  <div class="actions">
    <% if (isAdmin) { %><button class="btn" type="button" data-open="record-dlg">Add record</button><a class="btn primary" href="/vehicles/<%= item.id %>/edit">Edit Details</a><% } else { %><a class="btn" href="/defects/new?asset=vehicle:<%= item.id %>">Report defect</a><% } %>
  </div>
</div>
<%- include('partials/pane-end') %>
<% const openDefects = defects.filter((d) => d.status === 'open'); if (openDefects.length) { %>
<div class="alert-strip"><strong><%= openDefects.length %> open defect<%= openDefects.length > 1 ? 's' : '' %></strong>
  <span><%= openDefects.map((d) => d.description).join(' · ') %></span>
  <a href="#history" data-filter="defect">View</a></div>
<% } %>
<% const cls = (s) => ({ overdue: 'bad', soon: 'warn', ok: 'good' }[s.level] || ''); %>
<div class="kpis">
  <div class="kpi <%= cls(item.walkaround) %>"><div class="label">Today's walk-around</div><div class="value" style="font-size:1.3rem"><%= item.walkaround.level === 'ok' ? 'Done' : 'Not done' %></div><div class="sub"><%- pill(item.walkaround) %></div></div>
  <div class="kpi <%= cls(item.service) %>"><div class="label">Last service</div><div class="value" style="font-size:1.3rem"><%= ukDate(item.last_service_date) %></div><div class="sub">Next: <%- pill(item.service) %></div></div>
  <div class="kpi <%= cls(item.mot) %>"><div class="label">MOT expiry</div><div class="value" style="font-size:1.3rem"><%= ukDate(item.mot_due) %></div><div class="sub"><%- pill(item.mot) %></div></div>
  <div class="kpi <%= cls(item.tax) %>"><div class="label">Tax expiry</div><div class="value" style="font-size:1.3rem"><%= ukDate(item.tax_due) %></div><div class="sub"><%- pill(item.tax) %></div></div>
  <div class="kpi"><div class="label">Mileage</div><div class="value" style="font-size:1.3rem"><%= num(item.mileage) %></div><div class="sub">latest logged</div></div>
</div>

<div class="grid grid-2">
  <div>
    <div class="card" id="details-card">
      <h2>Details</h2>
      <dl class="facts">
        <dt>Status</dt><dd><span class="pill <%= item.status === 'active' ? 'ok' : 'none' %>"><%= VEHICLE_STATUSES[item.status] || item.status %></span></dd>
        <dt>Fleet no</dt><dd><%= item.asset_no || '—' %></dd>
        <dt>Category</dt><dd><%= VEHICLE_CATEGORIES[item.category] || '—' %></dd>
        <dt>Owner</dt><dd><%= OWNERS[item.owner] || item.owner || '—' %></dd>
        <dt>Colour</dt><dd><%= item.colour || '—' %></dd>
        <% if (item.vehicle_type) { %><dt>Vehicle type</dt><dd><%= item.vehicle_type %></dd><% } %>
        <dt>Fuel</dt><dd><%= FUEL_LABELS[item.fuel_type] || '—' %></dd>
        <dt>Assigned driver</dt><dd><%= item.driver_display || 'None' %></dd>
        <dt>Tracked</dt><dd><%= TRACKED[item.tracked] || 'Not known' %></dd>
        <dt>Driver app account</dt><dd><%= item.driver_name || 'None – walk-arounds not expected' %></dd>
        <% if (isAdmin) { %><dt>Purchased</dt><dd><%= ukDate(item.purchase_date) %><%= item.purchase_price != null ? ' · ' + money(item.purchase_price) : '' %></dd><% } %>
        <dt>Fuel cards</dt><dd><% if (!cards.length) { %>None linked<% if (isAdmin) { %> · <a href="/fuel-cards/new?vehicle=<%= item.id %>">Add</a><% } %><% } else { for (const c of cards) { const label = `${c.provider}${c.card_ref ? ' #' + c.card_ref : ''}${c.last4 ? ' ••' + c.last4 : ''}`; %>
          <div><% if (isAdmin) { %><a href="/fuel-cards/<%= c.id %>/edit"><%= label %></a><% } else { %><%= label %><% } %> <span class="pill <%= c.status === 'active' ? 'ok' : 'none' %>"><%= FUEL_CARD_STATUSES[c.status] %></span></div>
        <% } } %></dd>
      </dl>
      <% if (item.notes) { %><p style="white-space:pre-wrap;margin:12px 0 0"><%= item.notes %></p><% } %>
    </div>
    <%- include('partials/documents') %>
  </div>
  <div>
<%
  const kindName = DOC_KINDS.vehicle;
  const docsFor = (key, id) => documents.filter((d) => d[key] === id);
  const events = [
    ...records.map((r) => ({ dlg: 'rec-' + r.id, type: 'service', date: r.record_date, label: kindName[r.kind] || r.kind, reading: r.reading, text: [r.done_by, r.notes, r.next_due ? 'expires ' + ukDate(r.next_due) : ''].filter(Boolean).join(' · '), docs: docsFor('record_id', r.id) })),
    ...checks.map((c) => ({ type: 'check', date: c.check_date, label: 'Walk-around', reading: c.mileage, href: '/checks/vehicle/' + c.id, text: c.user_name, result: c.defects_found ? `<span class="pill overdue">${c.defects_found} defect${c.defects_found > 1 ? 's' : ''}</span>` : '<span class="pill ok">All OK</span>' })),
    ...defects.map((d) => ({ dlg: 'def-' + d.id, type: 'defect', date: d.reported_at, label: 'Defect', text: d.description + ' · ' + d.reported_by_name + (d.status === 'resolved' ? ' · Fixed: ' + (d.resolution || '') : ''), result: d.status === 'open' ? `<span class="pill ${d.severity}">${SEVERITY_LABELS[d.severity]}</span>` : '<span class="pill ok">Resolved</span>', docs: docsFor('defect_id', d.id) })),
  ].sort((a, b) => String(b.date).localeCompare(String(a.date)));
%>
    <div class="card flush" id="history">
      <div class="card-head"><h2>History</h2>
        <div class="subnav tl-filter"><a href="#history" class="active" data-filter="all">All</a><a href="#history" data-filter="service">Services</a><a href="#history" data-filter="check">Walk-arounds</a><a href="#history" data-filter="defect">Defects</a></div></div>
      <% if (!events.length) { %><p class="empty">Nothing recorded yet.</p><% } else { %>
      <div class="table-wrap tl-scroll"><table>
        <thead><tr><th>Date</th><th>Type</th><th class="num">Mileage</th><th>Details</th></tr></thead>
        <tbody><% for (const e of events) { %>
          <tr data-type="<%= e.type %>"<% if (e.dlg) { %> data-dlg="<%= e.dlg %>" class="clickable" title="Open"<% } %>><td class="nowrap"><% if (e.href) { %><a href="<%= e.href %>"><%= ukDate(e.date) %></a><% } else { %><%= ukDate(e.date) %><% } %></td><td class="nowrap"><%= e.label %></td><td class="num"><%= e.reading != null ? num(e.reading) : '—' %></td><td><%= e.text || '—' %><% if (e.result) { %> <%- e.result %><% } %><% if (e.docs && e.docs.length) { %><span class="doc-links"><% for (const d of e.docs) { %><a href="/documents/<%= d.id %>" target="_blank" rel="noopener" title="<%= d.name %>">📎 <%= e.docs.length > 1 ? d.name.slice(0, 18) : 'Document' %></a><% } %></span><% } %></td></tr>
        <% } %></tbody>
      </table>
      <p class="empty tl-none" hidden>Nothing of this type yet.</p></div><% } %>
    </div>
  </div>
</div>
<% if (isAdmin) { %>
<dialog id="record-dlg" class="dlg">
  <form class="card" method="post" action="/vehicles/<%= item.id %>/records" enctype="multipart/form-data">
    <div class="dlg-head"><h2>Add a record</h2><button class="dlg-x" type="button" data-close aria-label="Close">×</button></div>
    <div class="form-grid">
      <div class="field"><label for="kind">Type</label>
        <select id="kind" name="kind"><option value="service">Service</option><option value="mot">MOT pass</option><option value="tax">Tax renewed</option><option value="repair">Repair</option><option value="defect">Defect</option></select></div>
      <div class="field rec-field"><label for="record_date">Date</label><input id="record_date" name="record_date" type="date" value="<%= today %>" max="<%= today %>" required></div>
      <div class="field defect-field"><label for="severity">How serious?</label><select id="severity" name="severity">
        <option value="minor">Minor – safe to use, fix soon</option><option value="major">Major – needs fixing quickly</option><option value="unsafe">Unsafe – do not use</option></select></div>
      <div class="field" id="next-due-field"><label for="next_due">New expiry date <span class="hint" id="next-hint">(MOT: defaults to 1 year)</span></label><input id="next_due" name="next_due" type="date"></div>
      <div class="field rec-field"><label for="reading">Mileage</label><input id="reading" name="reading" type="number" min="0" step="1"></div>
      <div class="field rec-field"><label for="done_by">Done by</label><input id="done_by" name="done_by" type="text" placeholder="Garage"></div>
    </div>
    <div class="field"><label for="rnotes" id="rnotes-label">Notes</label><input id="rnotes" name="notes" type="text"></div>
    <div class="field"><label for="rdocs">Documents <span class="hint">(optional: certificates, invoices, photos or PDFs)</span></label><input id="rdocs" name="docs" type="file" accept="image/*,application/pdf" multiple></div>
    <div class="form-actions"><button class="btn" type="button" data-close>Cancel</button><button class="btn dark" type="submit">Save record</button></div>
  </form>
</dialog>
<% } %>
<script>
  (function () {
    const kind = document.getElementById('kind');
    if (kind) {
      const field = document.getElementById('next-due-field'), input = document.getElementById('next_due'), hint = document.getElementById('next-hint');
      function upd() {
        field.style.display = kind.value === 'mot' || kind.value === 'tax' ? '' : 'none';
        input.required = kind.value === 'tax';
        hint.textContent = kind.value === 'mot' ? '(defaults to 1 year)' : '(required)';
        const defect = kind.value === 'defect';
        document.querySelectorAll('.rec-field').forEach((el) => { el.style.display = defect ? 'none' : ''; });
        document.querySelectorAll('.defect-field').forEach((el) => { el.style.display = defect ? '' : 'none'; });
        const notes = document.getElementById('rnotes');
        notes.required = defect;
        notes.placeholder = defect ? 'Describe the defect' : '';
        document.getElementById('rnotes-label').textContent = defect ? 'What is wrong?' : 'Notes';
      }
      kind.addEventListener('change', upd); upd();
      const dlg = document.getElementById('record-dlg');
      document.querySelectorAll('[data-open="record-dlg"]').forEach((b) => b.addEventListener('click', () => dlg.showModal()));
      dlg.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    }
    const rows = document.querySelectorAll('#history tr[data-type]'), none = document.querySelector('.tl-none');
    let current = 'all';
    function filter(t) {
      current = t;
      let shown = 0;
      rows.forEach((r) => { const on = t === 'all' || r.dataset.type === t; r.hidden = !on; if (on) shown++; });
      document.querySelectorAll('.tl-filter a').forEach((a) => a.classList.toggle('active', a.dataset.filter === t));
      if (none) none.hidden = shown > 0;
    }
    document.querySelectorAll('[data-filter]').forEach((a) => a.addEventListener('click', (e) => {
      if (a.closest('.tl-filter')) e.preventDefault(); // filter in place, don't jump the page
      filter(a.dataset.filter);
    }));
    // On a computer screen the History card is always the same height as the Details card, and scrolls inside.
    // On a phone (cards stacked) the list shows the first six rows and scrolls.
    const box = document.querySelector('.tl-scroll'), card = document.getElementById('history'), details = document.getElementById('details-card');
    function fit() {
      if (innerWidth > 900) {
        card.style.height = details.offsetHeight + 'px';
        if (box) box.style.height = Math.max(120, card.getBoundingClientRect().bottom - box.getBoundingClientRect().top - 1) + 'px';
      } else {
        card.style.height = '';
        if (box) box.style.height = rows.length > 6 && current === 'all' ? rows[6].offsetTop + 'px' : box.style.height;
      }
    }
    fit(); addEventListener('resize', fit);
  })();
</script>
<%- include('partials/history-dialogs', { assetType: 'vehicle', recordName: (r) => kindName[r.kind] || r.kind, readingLabel: 'Mileage', fmtReading: (n) => num(n) }) %>
<%- include('partials/footer') %>
