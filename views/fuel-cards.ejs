<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Fuel cards</h1><p class="muted" style="margin:0">Who holds each card and which vehicle it's for. Card PINs are never stored here.</p></div>
  <div class="actions"><a class="btn" href="/fuel">Fuel dashboard</a><a class="btn primary" href="/fuel-cards/new">Add fuel card</a></div>
</div>
<div class="tabs">
  <a href="?show=active" class="<%= show === 'active' ? 'active' : '' %>">Active</a>
  <a href="?show=all" class="<%= show === 'all' ? 'active' : '' %>">All (incl. expired, stopped, cancelled)</a>
</div>
<div class="card flush">
  <% if (!cards.length) { %><p class="empty">No fuel cards yet. <a href="/fuel-cards/new">Add one.</a></p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Company</th><th>Card</th><th>Holder</th><th>Vehicle</th><th>Fuel</th><th>Expiry</th><th>Last used</th><th></th></tr></thead>
    <tbody><% for (const c of cards) { %>
      <tr>
        <td><%= c.provider %></td>
        <td class="nowrap"><%= c.card_ref ? '#' + c.card_ref : '' %> <span class="muted"><%= c.last4 ? '••••' + c.last4 : '' %></span></td>
        <td><%= c.holder || '—' %></td>
        <td><% if (c.reg) { %><a href="/vehicles/<%= c.vehicle_id %>"><span class="reg"><%= c.reg %></span></a><% } else { %>—<% } %></td>
        <td class="small"><%= c.card_type || '—' %></td>
        <td class="nowrap"><%= c.expiry ? c.expiry.slice(5, 7) + '/' + c.expiry.slice(0, 4) : '—' %> <% if (c.status !== 'active' || c.expiry) { %><%- pill(c.expiryStatus.level === 'ok' ? { level: 'ok', text: 'Active' } : c.expiryStatus) %><% } %></td>
        <td class="nowrap"><%= ukDate(c.last_used) %></td>
        <td><a href="/fuel-cards/<%= c.id %>/edit">Edit</a></td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<%- include('partials/footer') %>
