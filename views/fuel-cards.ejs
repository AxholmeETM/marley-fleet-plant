<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Fuel cards</h1><p class="muted" style="margin:0">Who holds each card and which vehicle it's for. Card PINs are never stored here.</p></div>
  <div class="actions"><a class="btn primary" href="/fuel-cards/new">Add fuel card</a></div>
</div>
<form class="filters" method="get">
  <div class="field"><label for="show">Status</label>
    <select id="show" name="show"><% for (const [k, l] of [['all', 'All'], ...Object.entries(FUEL_CARD_STATUSES)]) { %><option value="<%= k %>" <%= show === k ? 'selected' : '' %>><%= l %></option><% } %></select></div>
  <div class="field"><label for="company">Fuel company</label>
    <select id="company" name="company"><option value="">All</option><% for (const c of companies) { %><option <%= company === c ? 'selected' : '' %>><%= c %></option><% } %></select></div>
  <div class="field"><label for="name">Name on card</label>
    <select id="name" name="name"><option value="">All</option><% for (const n of names) { %><option <%= name === n ? 'selected' : '' %>><%= n %></option><% } %></select></div>
  <a class="btn" href="<%= path %>">Reset</a>
</form>
<%- include('partials/pane-end') %>
<div class="card flush">
  <% if (!cards.length) { %><p class="empty"><%= company || name ? 'No fuel cards match these filters.' : 'No fuel cards yet.' %> <a href="/fuel-cards/new">Add one.</a></p><% } else { %>
  <div class="table-wrap"><table class="nowrap-table fixed-cols">
    <colgroup><col style="width:24%"><col style="width:28%"><col style="width:22%"><col style="width:180px"><col style="width:190px"><col style="width:64px"></colgroup>
    <thead><tr><th>Company</th><th>Card</th><th>Name on card</th><th>Vehicle</th><th>Expiry</th><th></th></tr></thead>
    <tbody><% for (const c of cards) { %>
      <tr>
        <td title="<%= c.provider %>"><%= c.provider %></td>
        <td class="nowrap"><%= c.card_ref ? '#' + c.card_ref : '' %> <span class="muted"><%= c.card_number ? c.card_number.replace(/(.{4})(?=.)/g, '$1 ') : c.last4 ? '••••' + c.last4 : '' %></span></td>
        <td title="<%= c.user_name || c.holder || '' %>"><%= c.user_name || c.holder || '—' %></td>
        <td><% if (c.reg) { %><a href="/vehicles/<%= c.vehicle_id %>"><span class="reg"><%= c.reg %></span></a><% } else { %>—<% } %></td>
        <td class="nowrap"><%= c.expiry ? c.expiry.slice(5, 7) + '/' + c.expiry.slice(0, 4) : '—' %> <% if (c.status !== 'active' || c.expiry) { %><%- pill(c.expiryStatus.level === 'ok' ? { level: 'ok', text: 'Active' } : c.expiryStatus.level === 'overdue' && c.status === 'active' ? { level: 'overdue', text: 'Expired' } : c.expiryStatus.level === 'soon' ? { level: 'soon', text: 'Expiring' } : c.expiryStatus) %><% } %></td>
        <td><a href="/fuel-cards/<%= c.id %>/edit">Edit</a></td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<%- include('partials/footer') %>
