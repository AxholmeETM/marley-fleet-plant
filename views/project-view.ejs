<%- include('partials/header') %>
<div class="page-head">
  <div><h1><%= project.code %> <span class="muted" style="font-weight:400">– <%= project.name %></span></h1>
    <p class="muted" style="margin:0"><%= onProject.length %> item<%= onProject.length === 1 ? '' : 's' %> of plant and equipment · <%= project.active ? 'Open' : 'Closed' %></p></div>
</div>
<%- include('partials/pane-end') %>
<div class="grid grid-2" style="align-items:start">
  <div class="card">
    <h2>Details</h2>
    <form method="post" action="/projects/<%= encodeURIComponent(project.code) %>">
      <div class="field"><label for="name">Project / site</label><input id="name" name="name" type="text" value="<%= project.name %>" required></div>
      <div class="field"><label for="manager_id">Site manager</label>
        <select id="manager_id" name="manager_id"><option value="">None</option>
          <% for (const m of managers) { %><option value="<%= m.id %>" <%= m.id === project.manager_id ? 'selected' : '' %>><%= m.name %><%= m.active ? '' : ' (left)' %></option><% } %>
        </select>
        <p class="small muted" style="margin:6px 0 0"><%= managers.length ? 'They will see this project’s plant and equipment when they sign in.' : 'No site managers yet: set an employee’s type to Site manager on Employees.' %></p></div>
      <div class="field"><label for="active">Status</label><select id="active" name="active"><option value="1" <%= project.active ? 'selected' : '' %>>Open</option><option value="0" <%= project.active ? '' : 'selected' %>>Closed</option></select></div>
      <div class="form-actions"><button class="btn dark" type="submit">Save</button></div>
    </form>
  </div>
  <div class="card">
    <h2>Add plant or equipment</h2>
    <% if (!others.length) { %><p class="empty">Everything is already on this project.</p><% } else { %>
    <form method="post" action="/projects/<%= encodeURIComponent(project.code) %>/plant">
      <div class="field"><label for="pick-q">Find</label><input id="pick-q" type="search" placeholder="Asset no, description or project" autocomplete="off"></div>
      <div class="pick-list">
        <% for (const p of others) { %>
        <label class="pick" data-q="<%= [p.plant_no, p.description, p.job_ref].filter(Boolean).join(' ').toLowerCase() %>">
          <input type="checkbox" name="plant_id" value="<%= p.id %>">
          <span><strong><%= p.plant_no %></strong> <%= p.description %></span>
          <span class="small muted"><%= p.job_ref ? 'on ' + p.job_ref : 'no project' %></span>
        </label>
        <% } %>
      </div>
      <div class="form-actions"><span class="small muted" id="pick-n">None selected</span><button class="btn dark" type="submit">Add to <%= project.code %></button></div>
    </form>
    <script>
      (function () {
        const q = document.getElementById('pick-q'), rows = document.querySelectorAll('.pick'), n = document.getElementById('pick-n');
        q.addEventListener('input', () => { const t = q.value.trim().toLowerCase(); rows.forEach((r) => { r.hidden = !!t && !r.dataset.q.includes(t); }); });
        document.querySelector('.pick-list').addEventListener('change', () => {
          const k = document.querySelectorAll('.pick input:checked').length;
          n.textContent = k ? `${k} selected` : 'None selected';
        });
      })();
    </script>
    <p class="small muted" style="margin:10px 0 0">Items already on another project move to this one.</p>
    <% } %>
  </div>
</div>
<div class="card flush" id="plant">
  <div class="card-head" style="padding:18px 22px 0"><h2>Plant and equipment on this project</h2></div>
  <% if (!onProject.length) { %><p class="empty">Nothing booked to this project yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Asset no</th><th class="desc">Description</th><th>Category</th><th>Weekly check</th><th></th></tr></thead>
    <tbody><% for (const p of onProject) { %>
      <tr>
        <td class="nowrap"><a href="/plant/<%= p.id %>"><strong><%= p.plant_no %></strong></a></td>
        <td><%= p.description %></td>
        <td><%= (CATEGORY[p.category] || {}).label || p.category %></td>
        <td><%- pill(p.check.level === 'none' ? { level: 'none', text: 'No weekly check' } : p.check) %></td>
        <td class="num"><form method="post" action="/projects/<%= encodeURIComponent(project.code) %>/plant/<%= p.id %>/remove" style="margin:0"><button class="btn small" type="submit">Remove</button></form></td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<%- include('partials/footer') %>
