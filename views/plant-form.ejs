<%- include('partials/header') %>
<% const v = (k) => item[k] ?? ''; %>
<div class="page-head"><div><h1><%= title %></h1></div></div>
<%- include('partials/pane-end') %>
<form method="post" action="/plant<%= item.id ? '/' + item.id : '' %>" style="max-width:960px" id="plant-form">
  <fieldset class="card"><legend>Asset</legend>
    <div class="form-grid">
      <div class="field"><label for="category">Category</label>
        <select id="category" name="category">
          <% for (const c of CATEGORIES) { %><option value="<%= c.key %>" <%= item.category === c.key ? 'selected' : '' %>><%= c.label %></option><% } %>
        </select></div>
      <div class="field"><label for="owner">Owned by</label>
        <select id="owner" name="owner">
          <% for (const [k, l] of Object.entries(OWNERS)) { %><option value="<%= k %>" <%= item.owner === k ? 'selected' : '' %>><%= l %> (<%= k %>)</option><% } %>
        </select></div>
      <div class="field"><label for="plant_no">Asset number</label><input id="plant_no" name="plant_no" type="text" value="<%= v('plant_no') %>" required>
        <% if (!item.id) { %><span class="hint" id="asset-hint"></span><% } %></div>
      <div class="field"><label for="status">Status</label>
        <select id="status" name="status">
          <% for (const [k, l] of Object.entries(PLANT_STATUSES)) { %><option value="<%= k %>" <%= item.status === k ? 'selected' : '' %>><%= l %></option><% } %>
        </select></div>
      <div class="field"><label for="make">Manufacturer</label><input id="make" name="make" type="text" value="<%= v('make') %>"></div>
      <div class="field"><label for="model">Model / size</label><input id="model" name="model" type="text" value="<%= v('model') %>"></div>
      <div class="field"><label for="description">Description <span class="hint">(optional)</span></label><input id="description" name="description" type="text" value="<%= item.id ? v('description') : '' %>" placeholder="e.g. 13t tracked excavator"></div>
      <div class="field"><label for="serial_no">Serial / chassis number</label><input id="serial_no" name="serial_no" type="text" value="<%= v('serial_no') %>"></div>
      <div class="field"><label for="registered">Registered / year</label><input id="registered" name="registered" type="text" value="<%= v('registered') %>" placeholder="e.g. 2022"></div>
      <div class="field" data-for="chains attachment"><label for="swl">Safe working load (SWL)</label><input id="swl" name="swl" type="text" value="<%= v('swl') %>" placeholder="e.g. 4.25T @ 0-45°"></div>
    </div>
  </fieldset>

  <fieldset class="card"><legend>Where it is</legend>
    <div class="form-grid">
      <div class="field"><label for="job_ref">Job reference</label><input id="job_ref" name="job_ref" type="text" value="<%= v('job_ref') %>"></div>
      <div class="field"><label for="location">Site / location / person</label><input id="location" name="location" type="text" value="<%= v('location') %>" placeholder="e.g. Birley, Carcroft, yard"></div>
    </div>
  </fieldset>

  <fieldset class="card"><legend>Service plan</legend>
    <p class="hint" style="margin-top:0">Each machine has its own plan on engine hours. Defaults from manufacturer schedules: excavators and rollers 50, 250, 500 hrs then every 500 hrs; dumpers 100, 250, 500 then every 500; petrol plant 20 then every 100. Also due every 12 months (6 for petrol) if the hours aren't reached. Change it to match this machine's manual.</p>
    <label class="check-row field"><input type="checkbox" name="tracks_hours" value="1" id="tracks_hours" <%= item.tracks_hours ? 'checked' : '' %>> Has an hour meter (service due on running hours)</label>
    <label class="check-row field"><input type="checkbox" name="weekly_checks" value="1" id="weekly_checks" <%= item.weekly_checks ? 'checked' : '' %>> Needs a weekly plant check sheet</label>
    <label class="check-row field"><input type="checkbox" name="service_plan" value="1" <%= item.service_plan ? 'checked' : '' %>> Service plan included</label>
    <div class="form-grid">
      <div class="field hours-only"><label for="running_hours">Current running hours</label><input id="running_hours" name="running_hours" type="number" step="0.1" min="0" value="<%= v('running_hours') %>"></div>
      <div class="field hours-only"><label for="service_schedule">First services at <span class="hint">(hours)</span></label><input id="service_schedule" name="service_schedule" type="text" inputmode="numeric" value="<%= v('service_schedule') %>" placeholder="e.g. 50, 200, 500"></div>
      <div class="field hours-only"><label for="service_interval_hours">Then every <span class="hint">(hours)</span></label><input id="service_interval_hours" name="service_interval_hours" type="number" step="1" min="1" value="<%= v('service_interval_hours') %>"></div>
      <div class="field hours-only"><label for="service_months">Or every <span class="hint">(months, whichever first)</span></label><input id="service_months" name="service_months" type="number" step="1" min="1" value="<%= v('service_months') %>" placeholder="e.g. 12"></div>
      <div class="field hours-only"><label for="last_service_hours">Hours at last service</label><input id="last_service_hours" name="last_service_hours" type="number" step="0.1" min="0" value="<%= v('last_service_hours') %>"></div>
      <div class="field"><label for="last_service_date">Last service completed</label><input id="last_service_date" name="last_service_date" type="date" value="<%= v('last_service_date') %>"></div>
    </div>
  </fieldset>

  <fieldset class="card"><legend>LOLER, test and calibration</legend>
    <div class="form-grid">
      <div class="field"><label for="inspection_type">Needs</label>
        <select id="inspection_type" name="inspection_type">
          <% for (const [k, l] of Object.entries(INSPECTION_TYPES)) { %><option value="<%= k %>" <%= (item.inspection_type || (item.loler_required ? 'loler' : 'none')) === k ? 'selected' : '' %>><%= k === 'none' ? 'Nothing' : l %></option><% } %>
        </select></div>
      <div class="field insp-only"><label for="loler_interval_months">Every <span class="hint">(months)</span></label>
        <input id="loler_interval_months" name="loler_interval_months" type="number" min="1" step="1" value="<%= v('loler_interval_months') || 12 %>" list="intervals">
        <datalist id="intervals"><option value="6"><option value="12"></datalist></div>
      <div class="field insp-only"><label for="last_loler_date">Last tested / calibrated</label><input id="last_loler_date" name="last_loler_date" type="date" value="<%= v('last_loler_date') %>"></div>
      <div class="field insp-only"><label for="inspection_due">Due date <span class="hint">(blank = last + interval)</span></label><input id="inspection_due" name="inspection_due" type="date" value="<%= v('inspection_due') %>"></div>
      <div class="field insp-only"><label for="cert_no">Certificate number</label><input id="cert_no" name="cert_no" type="text" value="<%= v('cert_no') %>"></div>
    </div>
    <p class="hint" style="margin:0">LOLER: 12 months for lifting equipment, 6 months for lifting accessories (chains, slings, forks) or lifting people. Flags amber 30 days before it's due.</p>
  </fieldset>

  <fieldset class="card"><legend>Purchase and hire</legend>
    <div class="form-grid">
      <div class="field"><label for="purchase_price">Purchase price (£)</label><input id="purchase_price" name="purchase_price" type="number" step="0.01" min="0" value="<%= v('purchase_price') %>"></div>
      <div class="field"><label for="purchase_date">Purchase date</label><input id="purchase_date" name="purchase_date" type="date" value="<%= v('purchase_date') %>"></div>
      <div class="field mpl-only"><label for="transfer_price">Agreed price from MCL (£)</label><input id="transfer_price" name="transfer_price" type="number" step="0.01" min="0" value="<%= v('transfer_price') %>"></div>
      <div class="field"><label for="weekly_hire_rate">Weekly hire rate (£)</label><input id="weekly_hire_rate" name="weekly_hire_rate" type="number" step="0.01" min="0" value="<%= v('weekly_hire_rate') %>"></div>
    </div>
  </fieldset>

  <div class="card"><div class="field" style="margin:0"><label for="notes">Notes</label><textarea id="notes" name="notes"><%= v('notes') %></textarea></div></div>
  <div class="form-actions"><button class="btn primary" type="submit">Save</button><a class="btn" href="<%= item.id ? '/plant/' + item.id : '/plant' %>">Cancel</a></div>
</form>
<script>
  (function () {
    const cats = <%- JSON.stringify(Object.fromEntries(CATEGORIES.map((c) => [c.key, c]))) %>;
    const next = <%- JSON.stringify(nextNumbers) %>;
    const isNew = <%= item.id ? 'false' : 'true' %>;
    const $ = (id) => document.getElementById(id);
    const show = (sel, on) => document.querySelectorAll(sel).forEach((el) => { el.style.display = on ? '' : 'none'; });
    let autoNo = isNew ? next[$('owner').value + ':' + $('category').value] : null;
    if (isNew) $('plant_no').value = autoNo;
    function update(categoryChanged) {
      const c = cats[$('category').value];
      if (isNew && categoryChanged) {
        $('tracks_hours').checked = c.hours;
        $('weekly_checks').checked = c.checks;
        $('inspection_type').value = c.inspection;
        $('loler_interval_months').value = c.months;
        $('service_schedule').value = c.schedule;
        $('service_interval_hours').value = c.every;
        $('service_months').value = c.serviceMonths;
      }
      if (isNew && $('plant_no').value === autoNo) {
        autoNo = next[$('owner').value + ':' + $('category').value];
        $('plant_no').value = autoNo;
      }
      show('.hours-only', $('tracks_hours').checked);
      show('.insp-only', $('inspection_type').value !== 'none');
      show('.mpl-only', $('owner').value === 'MPL');
      document.querySelectorAll('[data-for]').forEach((el) => { el.style.display = el.dataset.for.split(' ').includes(c.key) ? '' : 'none'; });
    }
    $('category').addEventListener('change', () => update(true));
    ['owner', 'tracks_hours', 'inspection_type'].forEach((id) => $(id).addEventListener('change', () => update(false)));
    update(false);
  })();
</script>
<%- include('partials/footer') %>
