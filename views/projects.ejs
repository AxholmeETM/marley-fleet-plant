<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Projects <span class="count"><%= projects.filter((p) => p.active).length %> open</span></h1></div>
</div>
<form class="filters" method="post" action="/projects">
  <div class="field"><label for="code">Project No.</label><input id="code" name="code" type="text" placeholder="e.g. M26-011" required style="min-width:120px;width:140px"></div>
  <div class="field"><label for="name">Project / site</label><input id="name" name="name" type="text" placeholder="e.g. Rossington" required></div>
  <button class="btn primary" type="submit">Add project</button>
</form>
<%- include('partials/pane-end') %>
<div class="card flush">
  <% if (!projects.length) { %><p class="empty">No projects yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Project No.</th><th class="desc">Project / site</th><th class="num">Plant &amp; equipment</th><th>Status</th><th></th></tr></thead>
    <tbody><% for (const p of projects) { %>
      <tr>
        <td class="nowrap"><strong><%= p.code %></strong></td>
        <td colspan="4">
          <form class="inline-edit" method="post" action="/projects/<%= encodeURIComponent(p.code) %>">
            <input name="name" type="text" value="<%= p.name %>" required aria-label="Project / site for <%= p.code %>">
            <span class="num small muted"><%= p.items %> item<%= Number(p.items) === 1 ? '' : 's' %></span>
            <select name="active" aria-label="Status of <%= p.code %>"><option value="1" <%= p.active ? 'selected' : '' %>>Open</option><option value="0" <%= p.active ? '' : 'selected' %>>Closed</option></select>
            <button class="btn small" type="submit">Save</button>
          </form>
        </td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<p class="small muted">Closed projects no longer appear in the Project No. drop-downs. Items already booked to them keep their number.</p>
<%- include('partials/footer') %>
