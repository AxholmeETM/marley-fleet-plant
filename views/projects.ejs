<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Projects <span class="count"><%= projects.filter((p) => p.active).length %> open</span></h1></div>
</div>
<form class="filters" method="post" action="/projects">
  <div class="field"><label for="code">Project No.</label><input id="code" name="code" type="text" placeholder="e.g. M26-011" required style="min-width:120px;width:140px"></div>
  <div class="field"><label for="name">Project / site</label><input id="name" name="name" type="text" placeholder="e.g. Rossington" required></div>
  <button class="btn primary" type="submit">Add project</button>
</form>
<%- include('partials/pane-end') %>
<div class="card flush">
  <% if (!projects.length) { %><p class="empty">No projects yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Project No.</th><th class="desc">Project / site</th><th>Site manager</th><th class="num">Plant &amp; equipment</th><th>Status</th></tr></thead>
    <tbody><% for (const p of projects) { const href = '/projects/' + encodeURIComponent(p.code); %>
      <tr class="clickable" onclick="location.href='<%= href %>'">
        <td class="nowrap"><a href="<%= href %>"><strong><%= p.code %></strong></a></td>
        <td><%= p.name %></td>
        <td><%= p.manager_name || '—' %></td>
        <td class="num"><%= p.items %></td>
        <td><span class="pill <%= p.active ? 'ok' : 'none' %>"><%= p.active ? 'Open' : 'Closed' %></span></td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<p class="small muted">Click a project to pick its site manager and the plant on it. Closed projects no longer appear in the Project No. drop-downs; items already booked to them keep their number.</p>
<%- include('partials/footer') %>
