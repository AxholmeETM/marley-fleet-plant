<%- include('partials/header') %>
<% const noAccount = item.role !== 'admin' && (item.no_account || (item.id && !item.password_hash)); %>
<div class="page-head"><div><h1><%= title %></h1></div></div>
<%- include('partials/pane-end') %>
<form class="card" method="post" action="/users<%= item.id ? '/' + item.id : '' %>" style="max-width:760px">
  <h2>Employee</h2>
  <div class="form-grid">
    <div class="field"><label for="name">Name</label><input id="name" name="name" type="text" value="<%= item.name || '' %>" required></div>
    <div class="field"><label for="active">Status</label>
      <select id="active" name="active"><option value="1">Active</option><option value="0" <%= item.active === 0 ? 'selected' : '' %>>Disabled (cannot sign in)</option></select></div>
    <div class="field"><label for="employee_no">Employee ID</label><input id="employee_no" name="employee_no" type="text" value="<%= item.employee_no || '' %>" placeholder="e.g. 1042"></div>
    <div class="field"><label for="job_title">Job role</label>
      <input id="job_title" name="job_title" type="text" list="job-titles" value="<%= item.job_title || '' %>" placeholder="e.g. Groundworker, Site Manager, Plant Fitter">
      <datalist id="job-titles">
        <% for (const t of ['Groundworker', 'Plant Operator', 'Labourer', 'Ganger', 'Site Manager', 'Assistant Site Manager', 'Contracts Manager', 'Plant Fitter', 'Fleet Driver', 'Admin Assistant', 'Office Manager', 'Director']) { %><option value="<%= t %>"><% } %>
      </datalist></div>
  </div>
  <fieldset id="emp-type">
    <legend>Type</legend>
    <span class="seg">
      <% for (const [k, l] of Object.entries(EMPLOYEE_TYPES)) { %>
      <input type="radio" id="et-<%= k %>" name="employee_type" value="<%= k %>" <%= (item.employee_type || (item.role === 'admin' ? '' : 'driver')) === k ? 'checked' : '' %>><label for="et-<%= k %>"><%= l %></label>
      <% } %>
      <input type="radio" id="et-none" name="employee_type" value="" <%= item.role === 'admin' && !item.employee_type ? 'checked' : '' %>><label for="et-none" id="et-none-label">Neither</label>
    </span>
  </fieldset>

  <h2 class="form-section">Contact</h2>
  <div class="form-grid">
    <div class="field"><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" value="<%= item.phone || '' %>"></div>
    <div class="field"><label for="email">Email <span class="hint" id="email-hint"></span></label><input id="email" name="email" type="email" value="<%= item.email || '' %>"></div>
    <div class="field"><label for="work_email">Work email</label><input id="work_email" name="work_email" type="email" value="<%= item.work_email || '' %>"></div>
  </div>
  <div class="field"><label for="address">Address</label><textarea id="address" name="address" rows="3"><%= item.address || '' %></textarea></div>

  <h2 class="form-section">Sign-in options</h2>
  <span class="seg">
    <input type="radio" id="role-emp" name="role" value="driver" <%= item.role !== 'admin' && !noAccount ? 'checked' : '' %>><label for="role-emp">Employee</label>
    <input type="radio" id="role-admin" name="role" value="admin" <%= item.role === 'admin' ? 'checked' : '' %>><label for="role-admin">Admin user</label>
    <input type="radio" id="role-none" name="role" value="none" <%= noAccount ? 'checked' : '' %>><label for="role-none">No account needed</label>
  </span>
  <p class="hint" id="role-hint"></p>
  <div class="form-grid">
    <div class="field login-field"><label for="password"><%= item.id && item.password_hash ? 'Reset password' : 'Password' %> <span class="hint"><%= item.id && item.password_hash ? '(blank = keep)' : '(8+ characters, to sign in)' %></span></label>
      <input id="password" name="password" type="text" minlength="8" autocomplete="new-password"></div>
  </div>

  <h2 class="form-section">Personal</h2>
  <div class="form-grid">
    <div class="field"><label for="dob">Date of birth</label><input id="dob" name="dob" type="date" value="<%= item.dob || '' %>" max="<%= today %>"></div>
    <div class="field"><label for="licence_no">Driving licence number</label><input id="licence_no" name="licence_no" type="text" value="<%= item.licence_no || '' %>" maxlength="20" style="text-transform:uppercase"></div>
    <div class="field"><label for="ni_number">National Insurance number</label><input id="ni_number" name="ni_number" type="text" value="<%= item.ni_number || '' %>" placeholder="QQ 12 34 56 C" maxlength="13" style="text-transform:uppercase"></div>
  </div>

  <h2 class="form-section">Emergency contact</h2>
  <div class="form-grid">
    <div class="field"><label for="emergency_name">Name</label><input id="emergency_name" name="emergency_name" type="text" value="<%= item.emergency_name || '' %>"></div>
    <div class="field"><label for="emergency_phone">Phone number</label><input id="emergency_phone" name="emergency_phone" type="tel" value="<%= item.emergency_phone || '' %>"></div>
    <div class="field"><label for="emergency_email">Email</label><input id="emergency_email" name="emergency_email" type="email" value="<%= item.emergency_email || '' %>"></div>
  </div>
  <div class="form-actions"><button class="btn primary" type="submit">Save</button><a class="btn" href="<%= item.id ? '/users/' + item.id : '/users' %>">Cancel</a></div>
</form>
<div style="max-width:680px;margin-top:18px"><%- include('partials/who-sees-what') %></div>
<script>
  (function () {
    const hints = { driver: 'Can do walk-around and plant checks, log fuel with their fuel cards, and report defects.', admin: 'Sees everything: registers, fuel dashboard, fuel cards and users.',
      none: 'Logged on the system only, with no login.' };
    function upd() {
      const role = document.querySelector('input[name="role"]:checked').value;
      // Admins can also be a fleet driver or site manager, or neither.
      const none = document.getElementById('et-none');
      none.hidden = document.getElementById('et-none-label').hidden = role !== 'admin';
      if (role !== 'admin' && none.checked) document.getElementById('et-driver').checked = true;
      // No account means no password; the email is then just for contact.
      document.querySelectorAll('.login-field').forEach((f) => { f.hidden = role === 'none'; });
      document.getElementById('email-hint').textContent = role === 'none' ? '' : '(to sign in)';
      document.getElementById('role-hint').textContent = hints[role];
    }
    // Choosing No account needed picks Site worker, which can still be changed.
    document.querySelectorAll('input[name="role"]').forEach((r) => r.addEventListener('change', () => {
      if (r.value === 'none') document.getElementById('et-worker').checked = true;
      upd();
    }));
    upd();
  })();
</script>
<%- include('partials/footer') %>
