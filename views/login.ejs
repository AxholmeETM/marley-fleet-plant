<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · Marley Fleet &amp; Plant</title>
  <link rel="stylesheet" href="/static/style.css">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
</head>
<body>
<div class="login-wrap">
  <form class="login" method="post" action="/login">
    <div class="brand-mark">M</div>
    <h1>Marley Construction</h1>
    <p class="muted" style="margin-top:0">Fleet &amp; Plant Register</p>
    <% if (error) { %><div class="flash error"><%= error %></div><% } %>
    <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" value="<%= email %>" autocomplete="username" required autofocus></div>
    <div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
    <button class="btn primary big" type="submit">Sign in</button>
  </form>
</div>
</body>
</html>
