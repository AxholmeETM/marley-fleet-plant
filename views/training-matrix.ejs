<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Training Matrix</h1><p class="muted" style="margin:0">Expiry dates for each person. Click a date to update it, or a name to see all their training.</p></div>
</div>
<% const link = (o) => { const u = new URLSearchParams({ group: grp, ...(q ? { q } : {}), ...(attention ? { show: 'attention' } : {}), ...(showEmpty ? { empty: '1' } : {}), ...o }); for (const [k, v] of [...u]) if (v === '') u.delete(k); return '/training/matrix?' + u; }; %>
<nav class="tabs tm-tabs"><% for (const g of [...GROUPS, 'All']) { %><a href="<%= link({ group: g }) %>" class="<%= grp === g ? 'active' : '' %> t<%= GROUPS.indexOf(g) %>"><%= g %></a><% } %></nav>
<form class="filters" method="get">
  <input type="hidden" name="group" value="<%= grp %>">
  <div class="field"><label for="q">Search</label><input type="search" id="q" name="q" value="<%= q %>" placeholder="Name"></div>
  <div class="field"><span class="label">Show</span>
    <div class="seg funded"><input type="radio" id="sh-all" name="show" value="" <%= attention ? '' : 'checked' %> onchange="this.form.submit()"><label for="sh-all">Everyone</label><input type="radio" id="sh-att" name="show" value="attention" <%= attention ? 'checked' : '' %> onchange="this.form.submit()"><label for="sh-att">Needs attention</label></div></div>
  <% if (showEmpty) { %><input type="hidden" name="empty" value="1"><% } %>
  <button class="btn" type="submit">Search</button>
  <a class="btn" href="/training/matrix?group=<%= grp %>">Reset</a>
</form>
<%- include('partials/pane-end') %>
<div class="tm-legend">
  <span class="tm-legend-group"><span class="chip ok">In date</span><span class="chip soon">Within 30 days</span><span class="chip overdue">Expired</span><span class="chip needed">Needed</span><span class="chip note">Note</span></span>
  <span class="tm-legend-group"><span class="muted">CSCS card</span><% for (const c of ['green', 'red', 'blue', 'gold', 'black', 'white', 'partner']) { %><span class="cscs-chip"><span class="cscs cscs-<%= c %>"></span><%= c === 'partner' ? 'Partner' : c[0].toUpperCase() + c.slice(1) %></span><% } %></span>
  <span class="tm-legend-group"><span class="muted">NPORS / CPCS card</span><span class="cscs-chip"><span class="cscs cscs-red"></span>Red trained</span><span class="cscs-chip"><span class="cscs cscs-blue"></span>Blue competent</span><span class="cscs-chip"><span class="cscs cscs-gold"></span>Gold supervisor</span><span class="cscs-chip"><span class="cscs cscs-traditional"></span>Traditional</span><span class="cscs-chip"><span class="cscs cscs-grey"></span>Grey (CPCS)</span></span>
</div>
<div class="card flush tm-card">
  <% if (!people.length) { %><p class="empty"><%= attention ? 'Nothing needs attention here: nobody has anything expired or due within 30 days.' : q ? 'Nobody matches that search.' : 'Nobody is on the Training Matrix yet.' %></p><% } else { %>
  <div class="tm-wrap"><table class="tm-table">
    <thead>
      <tr class="tm-groups"><th class="tm-name" rowspan="2"><%= people.length %> <%= people.length === 1 ? 'person' : 'people' %></th><th class="tm-cards" rowspan="2">Cards</th><th class="tm-sum" rowspan="2">Status</th><% for (const g of GROUPS) { const n = courses.filter((c) => c.grp === g).length; if (n) { %><th class="tm-grp g<%= GROUPS.indexOf(g) %>" colspan="<%= n %>"><%= g %></th><% } } %></tr>
      <tr class="tm-heads"><% courses.forEach((c, i) => { %><th class="tm-course g<%= GROUPS.indexOf(c.grp) %><%= !i || courses[i - 1].grp !== c.grp ? ' gstart' : '' %>" title="<%= c.grp %>: <%= c.name %>"><%= c.short || c.name %><% if (c.info) { %> <button type="button" class="info-btn" aria-label="What is <%= c.name %>?" data-t="<%= c.grp %> · <%= c.name %>" data-b="<%= c.info %>">i</button><% } %></th><% }) %></tr>
    </thead>
    <tbody><% for (const p of people) { const t = summary(p); const card = CSCS_CARDS[p.cscs_card]; %>
      <tr>
        <th class="tm-name" scope="row">
          <a href="/training/people/<%= p.id %>"><%= p.name %></a>
          <% const np = cardsOf(p, 'npors'); %><% const cp = cardsOf(p, 'cpcs'); %><span class="tm-sub"><%= p.job_title || userLabel(p) %></span>
        </th>
        <td class="tm-cards"><% for (const [lab, list] of [['CSCS', card ? [card] : []], ['NPORS', np], ['CPCS', cp]]) { %><span class="card-pill<%= !list.length ? ' none' : list.length > 1 ? ' multi' : ' cscs-' + list[0].colour %>" title="<%= lab %>: <%= !list.length ? 'not recorded' : lab === 'CSCS' ? cscsLabel(p.cscs_card) : list.map((c) => c.label + ' · ' + c.name).join(', ') %>"><% if (list.length > 1) { %><span class="segs"><% for (const x of list) { %><span class="cscs-<%= x.colour %>"></span><% } %></span><b><%= lab %> ×<%= list.length %></b><% } else { %><%= lab %><% } %></span><% } %></td>
        <td class="tm-sum"><% if (t.overdue) { %><span class="badge overdue"><%= t.overdue %> expired</span><% } %><% if (t.soon) { %><span class="badge soon"><%= t.soon %> due</span><% } %><% if (t.needed) { %><span class="badge needed"><%= t.needed %> needed</span><% } %><% if (!t.overdue && !t.soon && !t.needed) { %><span class="badge ok">All in date</span><% } %></td>
        <% courses.forEach((c, i) => { const r = cell(p, c); const s = r && r.status; const rc = r && recordCard(c.grp, r.card); const cs = c.key === 'cscs' ? (card ? [card] : []) : rc ? [rc] : []; %><td tabindex="0" data-p="<%= p.id %>" data-c="<%= c.id %>" data-pn="<%= p.name %>" data-cn="<%= c.name %>" data-e="<%= r && r.expiry || '' %>" data-n="<%= r && r.note || '' %>" data-r="<%= r && r.required ? 1 : '' %>" data-g="<%= c.grp %>" data-k="<%= rc ? rc.key : '' %>" class="tm-cell<%= !i || courses[i - 1].grp !== c.grp ? ' gstart' : '' %>" title="<%= c.name %><%= s ? ': ' + s.text : '' %><%= r && r.note && r.expiry ? ' · ' + r.note : '' %><%= cs.length ? ' · ' + (c.key === 'cscs' ? 'CSCS' : 'Card') + ': ' + cs.map((x) => x.label + ' · ' + x.name).join(', ') : '' %>"><% if (s) { %><span class="chip <%= s.level %>"><% for (const x of cs) { %><span class="cscs cscs-<%= x.colour %>"></span><% } %><%= s.short %></span><% } %></td><% }) %>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<% if (hidden || showEmpty) { %><p class="muted tm-more"><% if (showEmpty) { %><a href="<%= link({ empty: '' }) %>">Hide courses nobody here holds</a><% } else { %><%= hidden %> course<%= hidden === 1 ? '' : 's' %> nobody here holds <%= hidden === 1 ? 'is' : 'are' %> hidden. <a href="<%= link({ empty: '1' }) %>">Show all courses</a><% } %></p><% } %>
<%- include('partials/training-dialog') %>
<%- include('partials/course-info') %>
<%- include('partials/footer') %>
