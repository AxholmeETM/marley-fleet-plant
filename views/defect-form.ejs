<%- include('partials/header') %>
<div class="page-head"><div><h1>Report a defect</h1><p class="muted" style="margin:0">For anything wrong with <%= plant.length ? 'a vehicle or piece of plant' : 'your vehicle' %> outside of a check.</p></div></div>
<%- include('partials/pane-end') %>
<form class="card" method="post" action="/defects" style="max-width:640px">
  <div class="field"><label for="asset">Plant or vehicle</label>
    <select id="asset" name="asset" required>
      <option value="">Choose…</option>
      <% if (vehicles.length) { %><optgroup label="<%= isAdmin ? 'Vehicles' : 'My vehicles' %>"><% for (const v of vehicles) { %><option value="vehicle:<%= v.id %>" <%= selected === 'vehicle:' + v.id ? 'selected' : '' %>><%= v.reg %> – <%= [v.make, v.model].filter(Boolean).join(' ') %></option><% } %></optgroup><% } %>
      <% if (plant.length) { %><optgroup label="Plant"><% for (const p of plant) { %><option value="plant:<%= p.id %>" <%= selected === 'plant:' + p.id ? 'selected' : '' %>><%= p.plant_no %> – <%= p.description %></option><% } %></optgroup><% } %>
    </select></div>
  <div class="field"><label for="description">What is wrong?</label><textarea id="description" name="description" required></textarea></div>
  <div class="field"><label for="severity">How serious?</label>
    <select id="severity" name="severity">
      <option value="minor">Minor – safe to use, fix soon</option>
      <option value="major">Major – needs fixing quickly</option>
      <option value="unsafe">Unsafe – do not use</option>
    </select></div>
  <button class="btn primary big" type="submit">Report defect</button>
</form>
<%- include('partials/footer') %>
