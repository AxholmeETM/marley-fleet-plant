<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Fleet register <span class="count"><%= vehicles.length %> vehicle<%= vehicles.length === 1 ? '' : 's' %></span></h1></div>
  <div class="actions"><a class="btn primary" href="/vehicles/new">Add vehicle</a></div>
</div>
<% const qs = (over) => new URLSearchParams(Object.fromEntries(Object.entries({ q, filter, category, ...over }).filter(([, x]) => x))).toString(); %>
<form class="filters" method="get">
  <div class="field"><label for="q">Search</label><input id="q" type="search" name="q" value="<%= q %>" placeholder="Reg, asset no, user, make…"></div>
  <div class="field"><label for="category">Type</label>
    <select id="category" name="category"><option value="">All types (<%= Object.values(counts).reduce((a, b) => a + b, 0) %>)</option>
      <% for (const [k, l] of Object.entries(VEHICLE_CATEGORIES)) { if (!counts[k] && category !== k) continue; %><option value="<%= k %>" <%= category === k ? 'selected' : '' %>><%= l %>s (<%= counts[k] || 0 %>)</option><% } %>
    </select></div>
  <div class="field"><label for="filter">Show</label>
    <select id="filter" name="filter">
      <option value="">All active vehicles</option>
      <option value="attention" <%= filter === 'attention' ? 'selected' : '' %>>Needs attention</option>
      <option value="sorn" <%= filter === 'sorn' ? 'selected' : '' %>>SORN / off road</option>
      <option value="inactive" <%= filter === 'inactive' ? 'selected' : '' %>>Sold</option>
    </select></div>
  <a class="btn" href="<%= path %>">Reset</a>
</form>
<%- include('partials/pane-end') %>
<div class="card flush">
  <% if (!vehicles.length) { %><p class="empty">No vehicles found. <a href="/vehicles/new">Add your first vehicle.</a></p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Reg</th><th class="desc">Vehicle</th><th>Assigned Driver</th><th>Next Service Due</th><th>MOT Expiry</th><th>Tax Due</th></tr></thead>
    <tbody><% for (const v of vehicles) { %>
      <tr>
        <td class="nowrap"><a href="/vehicles/<%= v.id %>"><span class="reg"><%= v.reg %></span></a></td>
        <td><%= [v.make, v.model].filter(Boolean).join(' ') %><% if (v.status !== 'active') { %> <span class="pill none"><%= VEHICLE_STATUSES[v.status] %></span><% } %></td>
        <td><%= v.driver_display || '—' %><% if (v.driver_display && !v.driver_id) { %><div class="small muted">no app account</div><% } %></td>
        <td><%- pill(v.service) %><% if (v.last_service_date) { %><div class="small muted">last <%= ukDate(v.last_service_date) %></div><% } %></td>
        <td><%- pill(v.mot) %></td>
        <td><%- pill(v.tax) %></td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<%- include('partials/footer') %>
