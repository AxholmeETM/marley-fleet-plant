<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Fleet register</h1><p class="muted" style="margin:0"><%= vehicles.length %> vehicle<%= vehicles.length === 1 ? '' : 's' %></p></div>
  <div class="actions"><a class="btn" href="/export/vehicles.csv">Export CSV</a><a class="btn primary" href="/vehicles/new">Add vehicle</a></div>
</div>
<form class="filters" method="get">
  <div class="field"><label for="q">Search</label><input id="q" type="search" name="q" value="<%= q %>" placeholder="Reg, driver, make…"></div>
  <div class="field"><label for="filter">Show</label>
    <select id="filter" name="filter">
      <option value="">All active vehicles</option>
      <option value="attention" <%= filter === 'attention' ? 'selected' : '' %>>Needs attention</option>
      <option value="inactive" <%= filter === 'inactive' ? 'selected' : '' %>>Sold / off road</option>
    </select></div>
  <button class="btn" type="submit">Apply</button>
</form>
<div class="card flush">
  <% if (!vehicles.length) { %><p class="empty">No vehicles found. <a href="/vehicles/new">Add your first vehicle.</a></p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Reg</th><th>Vehicle</th><th>Driver</th><th>Today's walk-around</th><th>Last service</th><th>Service due</th><th>MOT</th><th>Tax</th><th>Defects</th></tr></thead>
    <tbody><% for (const v of vehicles) { %>
      <tr>
        <td><a href="/vehicles/<%= v.id %>"><span class="reg"><%= v.reg %></span></a></td>
        <td><%= [v.make, v.model].filter(Boolean).join(' ') %><div class="small muted"><%= v.vehicle_type || '' %></div></td>
        <td><%= v.driver_name || '—' %></td>
        <td><%- pill(v.walkaround) %></td>
        <td class="nowrap"><%= ukDate(v.last_service_date) %></td>
        <td><%- pill(v.service) %></td>
        <td><%- pill(v.mot) %></td>
        <td><%- pill(v.tax) %></td>
        <td><%- v.open_defects ? `<span class="pill overdue">${v.open_defects} open</span>` : '<span class="muted">—</span>' %></td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<%- include('partials/footer') %>
