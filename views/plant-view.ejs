<%- include('partials/header') %>
<div class="page-head">
  <div><h1><%= item.plant_no %> <span class="muted" style="font-weight:400">– <%= item.description %></span></h1>
    <p class="muted" style="margin:0"><%= [item.make, item.model].filter(Boolean).join(' ') || '' %><%= item.serial_no ? ' · S/N ' + item.serial_no : '' %><%= item.active ? '' : ' · Off hire / disposed' %></p></div>
  <div class="actions">
    <a class="btn" href="/checks/plant/new?plant=<%= item.id %>">New check sheet</a>
    <a class="btn" href="/defects/new?asset=plant:<%= item.id %>">Report defect</a>
    <a class="btn primary" href="/plant/<%= item.id %>/edit">Edit</a>
  </div>
</div>
<div class="kpis">
  <div class="kpi"><div class="label">Job reference</div><div class="value" style="font-size:1.3rem"><%= item.job_ref || '—' %></div><div class="sub"><%= item.location || '&nbsp;' %></div></div>
  <div class="kpi"><div class="label">Running hours</div><div class="value"><%= fmtHours(item.running_hours) %></div><div class="sub">service every <%= fmtHours(item.service_interval_hours) %> hrs</div></div>
  <div class="kpi <%= { overdue: 'bad', soon: 'warn', ok: 'good' }[item.service.level] || '' %>"><div class="label">Next service</div><div class="value"><%= fmtHours(item.service.nextAt) %> hrs</div><div class="sub"><%- pill(item.service) %></div></div>
  <div class="kpi <%= { overdue: 'bad', soon: 'warn', ok: 'good' }[item.check.level] || '' %>"><div class="label">Weekly check</div><div class="value" style="font-size:1.3rem"><%= ukDate(item.last_check) %></div><div class="sub"><%- pill(item.check) %></div></div>
  <div class="kpi <%= { overdue: 'bad', soon: 'warn', ok: 'good' }[item.loler.level] || '' %>"><div class="label">LOLER</div><div class="value" style="font-size:1.3rem"><%= item.loler_required ? ukDate(item.loler.due) : 'N/A' %></div><div class="sub"><%- pill(item.loler) %></div></div>
</div>

<div class="grid grid-2">
  <div>
    <div class="card flush">
      <h2>Defects</h2>
      <% if (!defects.length) { %><p class="empty">No defects reported.</p><% } else { %>
      <div class="table-wrap"><table><tbody><% for (const d of defects) { %>
        <tr><td class="nowrap"><%= ukDate(d.reported_at) %></td><td><%= d.description %><div class="small muted"><%= d.reported_by_name %><%= d.status === 'resolved' ? ' · Fixed: ' + (d.resolution || '') : '' %></div></td>
          <td><% if (d.status === 'open') { %><span class="pill <%= d.severity %>"><%= SEVERITY_LABELS[d.severity] %></span><% } else { %><span class="pill ok">Resolved</span><% } %></td></tr>
      <% } %></tbody></table></div>
      <p class="empty" style="padding-top:8px"><a href="/defects?asset=plant">Manage defects →</a></p><% } %>
    </div>
    <div class="card flush">
      <h2>Check sheets</h2>
      <% if (!checks.length) { %><p class="empty">No check sheets yet.</p><% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>By</th><th class="num">Hours</th><th>Job ref</th><th>Result</th></tr></thead>
        <tbody><% for (const c of checks) { %>
          <tr><td><a href="/checks/plant/<%= c.id %>"><%= ukDate(c.check_date) %></a></td><td><%= c.user_name %></td><td class="num"><%= fmtHours(c.hours) %></td><td><%= c.job_ref || '—' %></td>
            <td><%- c.defects_found ? `<span class="pill overdue">${c.defects_found} defect${c.defects_found > 1 ? 's' : ''}</span>` : '<span class="pill ok">All OK</span>' %></td></tr>
        <% } %></tbody>
      </table></div><% } %>
    </div>
  </div>
  <div>
    <form class="card" method="post" action="/plant/<%= item.id %>/records">
      <h2>Record a service or LOLER inspection</h2>
      <div class="form-grid">
        <div class="field"><label for="kind">Type</label><select id="kind" name="kind"><option value="service">Service</option><option value="loler">LOLER thorough examination</option></select></div>
        <div class="field"><label for="record_date">Date</label><input id="record_date" name="record_date" type="date" value="<%= today %>" max="<%= today %>" required></div>
        <div class="field"><label for="reading">Running hours <span class="hint">(at the time)</span></label><input id="reading" name="reading" type="number" step="0.1" min="0" value="<%= item.running_hours %>"></div>
        <div class="field"><label for="done_by">Done by</label><input id="done_by" name="done_by" type="text" placeholder="Fitter / inspection company"></div>
      </div>
      <div class="field"><label for="rnotes">Notes</label><input id="rnotes" name="notes" type="text" placeholder="Certificate no., parts, etc."></div>
      <button class="btn dark" type="submit">Save record</button>
    </form>
    <div class="card flush">
      <h2>Service and LOLER history</h2>
      <% if (!records.length) { %><p class="empty">No records yet.</p><% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>Type</th><th class="num">Hours</th><th>Done by / notes</th></tr></thead>
        <tbody><% for (const r of records) { %>
          <tr><td><%= ukDate(r.record_date) %></td><td><%= r.kind === 'loler' ? 'LOLER' : 'Service' %></td><td class="num"><%= r.reading != null ? fmtHours(r.reading) : '—' %></td><td><%= [r.done_by, r.notes].filter(Boolean).join(' · ') || '—' %></td></tr>
        <% } %></tbody>
      </table></div><% } %>
    </div>
    <% if (item.notes) { %><div class="card"><h2>Notes</h2><p style="white-space:pre-wrap;margin:0"><%= item.notes %></p></div><% } %>
  </div>
</div>
<%- include('partials/footer') %>
