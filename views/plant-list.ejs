<%- include('partials/header') %>
<%
  const qs = (over) => new URLSearchParams(Object.fromEntries(Object.entries({ q, filter, owner, category, ...over }).filter(([, x]) => x))).toString();
  const total = Object.values(counts).reduce((a, b) => a + b, 0);
  const cat = category ? CATEGORY[category] : null;
  const showHours = cat ? cat.hours : plant.some((p) => p.tracks_hours);
  const showChecks = cat ? cat.checks : plant.some((p) => p.weekly_checks);
%>
<div class="page-head">
  <div><h1><%= section.label %> <span class="count"><%= plant.length %> item<%= plant.length === 1 ? '' : 's' %></span></h1></div>
  <% if (isAdmin) { %><div class="actions"><a class="btn primary" href="/plant/new?category=<%= category || CATEGORIES[0].key %>">Add <%= cat ? cat.label.replace(/s$/, '').toLowerCase() : section.noun %></a></div><% } else { %><div class="actions"><a class="btn primary" href="/checks/plant/new">New check sheet</a></div><% } %>
</div>
<form class="filters" method="get">
  <div class="field"><label for="q">Search</label><input id="q" type="search" name="q" value="<%= q %>" placeholder="Asset no, serial, project no…"></div>
  <div class="field"><label for="category">Type</label>
    <select id="category" name="category"><option value="">All types (<%= total %>)</option>
      <% for (const c of CATEGORIES) { if (!counts[c.key] && category !== c.key) continue; %><option value="<%= c.key %>" <%= category === c.key ? 'selected' : '' %>><%= c.label %> (<%= counts[c.key] || 0 %>)</option><% } %>
    </select></div>
  <div class="field"><label for="owner">Owner</label>
    <select id="owner" name="owner"><option value="">Both companies</option>
      <% for (const [k, l] of Object.entries(OWNERS)) { %><option value="<%= k %>" <%= owner === k ? 'selected' : '' %>><%= l %></option><% } %>
    </select></div>
  <div class="field"><label for="filter">Show</label>
    <select id="filter" name="filter">
      <option value="">All current items</option>
      <option value="attention" <%= filter === 'attention' ? 'selected' : '' %>>Needs attention</option>
      <option value="repair" <%= filter === 'repair' ? 'selected' : '' %>>At repair</option>
      <option value="inactive" <%= filter === 'inactive' ? 'selected' : '' %>>Sold, stolen or disposed</option>
    </select></div>
  <a class="btn" href="<%= path %>">Reset</a>
</form>
<%- include('partials/pane-end') %>
<div class="card flush">
  <% if (!plant.length) { %><p class="empty">Nothing here yet.<% if (isAdmin) { %> <a href="/plant/new?category=<%= category || CATEGORIES[0].key %>">Add an item.</a><% } %></p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Asset no</th><th class="desc">Description</th><% if (!category) { %><th>Category</th><% } else { %><th>Serial no</th><% } %><th>Project No.</th>
      <% if (showHours) { %><th class="num">Hours</th><th class="w-pill">Service</th><% } else { %><th>Last service</th><% } %>
      <% if (showChecks) { %><th class="w-pill">Check</th><% } %><th class="w-pill">Inspection</th><th>Status</th></tr></thead>
    <tbody><% for (const p of plant) { %>
      <tr>
        <td class="nowrap"><a href="/plant/<%= p.id %>"><strong><%= p.plant_no %></strong></a></td>
        <td><%= p.description %><div class="small muted"><%= [p.description !== [p.make, p.model].filter(Boolean).join(' ') ? [p.make, p.model].filter(Boolean).join(' ') : '', p.swl ? 'SWL ' + p.swl : ''].filter(Boolean).join(' · ') %></div></td>
        <% if (!category) { %><td class="small"><%= CATEGORY[p.category] ? CATEGORY[p.category].label : p.category %></td><% } %>
        <% if (category) { %><td class="small serial"><%= p.serial_no || '—' %></td><% } %>
        <td><span class="nowrap"><%= p.job_ref || '—' %></span><% if (p.project_name) { %><div class="small muted"><%= p.project_name %></div><% } %></td>
        <% if (showHours) { %>
          <td class="num"><%= p.tracks_hours ? fmtHours(p.running_hours) : '—' %></td>
          <td><%- pill(p.service) %></td>
        <% } else { %><td class="nowrap"><%= ukDate(p.last_service_date) %></td><% } %>
        <% if (showChecks) { %><td><%- pill(p.check) %></td><% } %>
        <td><%- pill(p.loler) %><% if (p.loler.level !== 'none') { %><div class="small muted"><%= INSPECTION_TYPES[p.inspection_type] %></div><% } %></td>
        <td><span class="pill <%= p.status === 'in_use' ? 'ok' : ['stolen', 'repair'].includes(p.status) ? 'overdue' : 'none' %> nowrap"><%= p.status === 'in_use' ? 'In use' : PLANT_STATUSES[p.status] || p.status %></span>
          <% if (p.open_defects) { %><div><span class="pill overdue"><%= p.open_defects %> defect<%= p.open_defects > 1 ? 's' : '' %></span></div><% } %></td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<%- include('partials/footer') %>
