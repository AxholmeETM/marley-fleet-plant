<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Plant register</h1><p class="muted" style="margin:0"><%= plant.length %> item<%= plant.length === 1 ? '' : 's' %></p></div>
  <div class="actions"><a class="btn" href="/export/plant.csv">Export CSV</a><a class="btn primary" href="/plant/new">Add plant</a></div>
</div>
<form class="filters" method="get">
  <div class="field"><label for="q">Search</label><input id="q" type="search" name="q" value="<%= q %>" placeholder="Plant ID, job ref, make…"></div>
  <div class="field"><label for="filter">Show</label>
    <select id="filter" name="filter">
      <option value="">All active plant</option>
      <option value="attention" <%= filter === 'attention' ? 'selected' : '' %>>Needs attention</option>
      <option value="inactive" <%= filter === 'inactive' ? 'selected' : '' %>>Off hire / disposed</option>
    </select></div>
  <button class="btn" type="submit">Apply</button>
</form>
<div class="card flush">
  <% if (!plant.length) { %><p class="empty">No plant found. <a href="/plant/new">Add your first item.</a></p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Plant ID</th><th>Description</th><th>Job ref</th><th class="num">Running hrs</th><th>Service</th><th>Weekly check</th><th>LOLER</th><th>Defects</th></tr></thead>
    <tbody><% for (const p of plant) { %>
      <tr>
        <td class="nowrap"><a href="/plant/<%= p.id %>"><strong><%= p.plant_no %></strong></a></td>
        <td><%= p.description %><div class="small muted"><%= [p.make, p.model].filter(Boolean).join(' ') %></div></td>
        <td><%= p.job_ref || '—' %></td>
        <td class="num"><%= fmtHours(p.running_hours) %></td>
        <td><%- pill(p.service) %><div class="small muted">at <%= fmtHours(p.service.nextAt) %> hrs</div></td>
        <td><%- pill(p.check) %></td>
        <td><%- pill(p.loler) %></td>
        <td><%- p.open_defects ? `<span class="pill overdue">${p.open_defects} open</span>` : '<span class="muted">—</span>' %></td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<%- include('partials/footer') %>
