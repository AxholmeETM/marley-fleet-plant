<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Defects</h1><p class="muted" style="margin:0">Reported from checks or directly by drivers and operatives</p></div>
  <div class="actions"><a class="btn primary" href="/defects/new">Report a defect</a></div>
</div>
<form class="filters" method="get">
  <div class="field"><label for="status">Status</label>
    <select id="status" name="status"><% for (const [k, l] of [['open', 'Open'], ['resolved', 'Resolved'], ['all', 'All']]) { %><option value="<%= k %>" <%= statusFilter === k ? 'selected' : '' %>><%= l %></option><% } %></select></div>
  <div class="field"><label for="asset">Type</label>
    <select id="asset" name="asset"><% for (const [k, l] of [['', 'All'], ...CATEGORIES.map((c) => [c.key, c.label]), ['vehicle', 'Vehicles']]) { %><option value="<%= k %>" <%= assetFilter === k ? 'selected' : '' %>><%= l %></option><% } %></select></div>
  <a class="btn" href="<%= path %>">Reset</a>
</form>
<%- include('partials/pane-end') %>
<div class="card flush">
  <% const back = `/defects?status=${statusFilter}${assetFilter ? '&asset=' + assetFilter : ''}`; %>
  <% if (!defects.length) { %><p class="empty">No defects here.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Reported</th><th>Asset</th><th>Defect</th><th>Severity</th><th>Documents</th><th>Status</th></tr></thead>
    <tbody><% for (const d of defects) { %>
      <tr>
        <td class="nowrap"><%= ukDate(d.reported_at) %><div class="small muted"><%= d.reported_by_name %></div></td>
        <td><a href="/<%= d.asset_type === 'plant' ? 'plant' : 'vehicles' %>/<%= d.asset_id %>"><%= d.asset_name %></a>
          <% if (d.check_id) { %><div class="small"><a href="/checks/<%= d.asset_type %>/<%= d.check_id %>">From check</a></div><% } %></td>
        <td><%= d.description %></td>
        <td><span class="pill <%= d.severity %>"><%= SEVERITY_LABELS[d.severity] %></span></td>
        <td class="defect-docs">
          <% for (const doc of d.docs) { %><a href="/documents/<%= doc.id %>" target="_blank" rel="noopener" title="<%= doc.name %>">📎 <%= doc.name.length > 22 ? doc.name.slice(0, 20) + '…' : doc.name %></a><% } %>
          <form method="post" action="/defects/<%= d.id %>/documents" enctype="multipart/form-data" class="doc-attach">
            <input type="hidden" name="back" value="<%= back %>">
            <label class="doc-add-link">+ Add<input type="file" name="docs" accept="image/*,application/pdf" multiple hidden></label>
          </form>
        </td>
        <td style="min-width:240px">
          <% if (d.status === 'open') { %>
            <form class="price-form" method="post" action="/defects/<%= d.id %>/resolve">
              <input type="hidden" name="back" value="<%= back %>">
              <input type="text" name="resolution" placeholder="What was done?" required aria-label="Resolution">
              <button class="btn small" type="submit">Resolve</button>
            </form>
          <% } else { %>
            <span class="pill ok">Resolved <%= ukDate(d.resolved_at) %></span>
            <div class="small"><%= d.resolution %><% if (d.resolved_by_name) { %> – <%= d.resolved_by_name %><% } %></div>
            <form class="inline" method="post" action="/defects/<%= d.id %>/reopen"><button class="linkbtn small" style="color:var(--blue)" type="submit">Reopen</button></form>
          <% } %>
        </td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</div>
<script>
  // Picking files on a defect uploads them straight away.
  document.querySelectorAll('.doc-attach input[type=file]').forEach((f) => f.addEventListener('change', () => { if (f.files.length) f.form.submit(); }));
</script>
<%- include('partials/footer') %>
