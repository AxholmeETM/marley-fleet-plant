<%- include('partials/header') %>
<div class="page-head"><div><h1><%= title %></h1></div></div>
<%- include('partials/pane-end') %>
<form class="card" method="post" action="/fuel-cards<%= item.id ? '/' + item.id : '' %>" style="max-width:760px">
  <div class="form-grid">
    <div class="field"><label for="provider">Fuel card company</label>
      <input id="provider" name="provider" type="text" list="providers" value="<%= item.provider || '' %>" required>
      <datalist id="providers"><% for (const p of FUEL_CARD_PROVIDERS) { %><option value="<%= p %>"><% } %></datalist></div>
    <div class="field"><label for="card_ref">Card no / name on your list</label><input id="card_ref" name="card_ref" type="text" value="<%= item.card_ref || '' %>" placeholder="e.g. 12 or TE"></div>
    <div class="field"><label for="card_number">Card number</label><input id="card_number" name="card_number" type="text" inputmode="numeric" maxlength="30" value="<%= item.card_number || item.last4 || '' %>" autocomplete="off"></div>
    <div class="field"><label for="holder">Name on card</label><input id="holder" name="holder" type="text" value="<%= item.holder || '' %>"></div>
    <div class="field"><label for="vehicle_id">Vehicle</label>
      <select id="vehicle_id" name="vehicle_id"><option value="">Not tied to a vehicle</option>
        <% for (const v of vehicles) { %><option value="<%= v.id %>" <%= item.vehicle_id === v.id ? 'selected' : '' %>><%= v.reg %><%= v.driver_display ? ' – ' + v.driver_display : '' %></option><% } %>
      </select></div>
    <div class="field"><label for="card_type">Card type</label><input id="card_type" name="card_type" type="text" list="ctypes" value="<%= item.card_type || '' %>">
      <datalist id="ctypes"><option value="Diesel / Unleaded"><option value="Diesel only"><option value="Diesel / AdBlue"><option value="All fuels"></datalist></div>
    <div class="field"><label for="expiry">Expires <span class="hint">(month)</span></label><input id="expiry" name="expiry" type="month" value="<%= item.expiry || '' %>"></div>
    <div class="field"><label for="status">Status</label>
      <select id="status" name="status"><% for (const [k, l] of Object.entries(FUEL_CARD_STATUSES)) { %><option value="<%= k %>" <%= item.status === k ? 'selected' : '' %>><%= l %></option><% } %></select></div>
  </div>
  <div class="field"><label for="notes">Notes</label><input id="notes" name="notes" type="text" value="<%= item.notes || '' %>"></div>
  <p class="hint">Never record card PINs here. Keep PINs with the card company or in a password manager.</p>
  <div class="form-actions"><button class="btn primary" type="submit">Save</button><a class="btn" href="/fuel-cards">Cancel</a></div>
</form>
<%- include('partials/footer') %>
