<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Dashboard</h1><p class="muted" style="margin:0"><%= ukDate(today) %><% if (manager) { %> · <%= projects.length ? 'Project' + (projects.length === 1 ? ' ' : 's ') + projects.join(', ') : 'No projects assigned yet' %><% } %> · <%= stats.plantOnly %> plant · <%= stats.plantTotal - stats.plantOnly %> equipment · <%= stats.vehicleTotal %> vehicle<%= stats.vehicleTotal === 1 ? '' : 's' %></p></div>
</div>
<%- include('partials/pane-end') %>
<div class="kpis kpis-4">
  <a class="kpi <%= stats.unsafe ? 'bad' : 'good' %>" href="<%= manager ? '#todo' : '/defects' %>"<% if (manager) { %> data-goto="defects"<% } %>><div class="label">Unsafe defects</div><div class="value"><%= stats.unsafe %></div>
    <div class="sub"><%= stats.unsafe ? 'do not use until fixed' : 'none reported' %></div></a>
  <a class="kpi <%= stats.overdue ? 'bad' : 'good' %>" href="#todo" data-goto="overdue"><div class="label">Overdue</div><div class="value"><%= stats.overdue %></div>
    <div class="sub">services, inspections, MOT, tax, checks</div></a>
  <a class="kpi <%= stats.dueSoon ? 'warn' : 'good' %>" href="#todo" data-goto="soon"><div class="label">Coming up</div><div class="value"><%= stats.dueSoon %></div>
    <div class="sub">due in the next 30 days</div></a>
  <% if (manager) { %>
  <a class="kpi plain" href="/plant"><div class="label">My plant</div><div class="value"><%= stats.plantOnly %></div>
    <div class="sub">plus <%= stats.plantTotal - stats.plantOnly %> equipment item<%= stats.plantTotal - stats.plantOnly === 1 ? '' : 's' %> on my projects</div></a>
  <% } else { %>
  <a class="kpi <%= stats.receipts ? 'warn' : 'good' %>" href="/fuel/log?show=unverified&period=year"><div class="label">Receipts to check</div><div class="value"><%= stats.receipts %></div>
    <div class="sub"><%= stats.receiptsCost ? money(stats.receiptsCost) + ' waiting for the office' : 'waiting for the office' %></div></a>
  <% } %>
</div>

<div class="dash-grid">
  <div class="card flush todo" id="todo">
    <%
      // Tabs: open defects, anything overdue, and what falls due in the next 30 days. Each list scrolls inside the card.
      const tabOf = (t) => t.tab;
      const TABS = [['defects', 'Defects', 'No open defects.'], ['overdue', 'Overdue', 'Nothing overdue.'], ['soon', 'Coming up', 'Nothing due in the next 30 days.']];
      const firstTab = (TABS.find(([k]) => todo.some((t) => tabOf(t) === k)) || TABS[0])[0];
    %>
    <div class="card-head todo-head"><h2>To do</h2>
      <div class="seg-tabs" role="tablist">
        <% for (const [k, label] of TABS) { const n = todo.filter((t) => tabOf(t) === k).reduce((sum, t) => sum + t.count, 0); %>
        <button type="button" role="tab" data-tab="<%= k %>" aria-selected="<%= k === firstTab %>"><%= label %> <span class="n"><%= n %></span></button>
        <% } %>
      </div>
    </div>
    <% for (const [k, , empty] of TABS) { const rows = todo.filter((t) => tabOf(t) === k); %>
    <div class="todo-scroll" data-panel="<%= k %>" <%= k === firstTab ? '' : 'hidden' %>>
    <% if (!rows.length) { %><p class="empty"><%= empty %> 👍</p><% } else { %>
    <ul>
      <% for (const t of rows) { %>
      <li class="lv-<%= t.level %>">
        <div class="todo-main">
          <a class="todo-title" href="<%= t.href %>"><% if (t.reg) { %><span class="reg sm"><%= t.reg %></span> <% } %><%= t.title %></a>
          <div class="todo-detail"><%= t.detail %></div>
        </div>
        <a class="btn small <%= t.primary ? 'primary' : '' %>" href="<%= t.href %>"><%= t.action %></a>
      </li>
      <% } %>
    </ul>
    <% } %>
    </div>
    <% } %>
  </div>
  <script>
    (function () {
      const tabs = document.querySelectorAll('#todo [data-tab]');
      const show = (k) => {
        tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === k)));
        document.querySelectorAll('#todo [data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== k; });
      };
      tabs.forEach((b) => b.addEventListener('click', () => { show(b.dataset.tab); fit(); }));
      // The Overdue and Coming up tiles open their tab.
      document.querySelectorAll('[data-goto]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); show(a.dataset.goto); fit(); }));
      // On a computer screen the page fits the window: the To do list takes the space left and scrolls inside itself.
      function fit() {
        const panels = document.querySelectorAll('#todo [data-panel]');
        panels.forEach((p) => { p.style.maxHeight = ''; });
        if (window.innerWidth <= 1100) return;
        const open = [...panels].find((p) => !p.hidden);
        if (!open) return;
        const spare = document.documentElement.scrollHeight - window.innerHeight;
        const h = open.getBoundingClientRect().height - spare;
        panels.forEach((p) => { p.style.maxHeight = Math.max(220, h) + 'px'; });
      }
      window.addEventListener('resize', fit);
      fit();
    })();
  </script>

  <div class="dash-side">
    <% if (manager) { %>
    <div class="card flush">
      <h2>My vehicle and fuel card</h2>
      <div class="today-list">
        <% for (const v of myVehicles) { %><a href="/vehicles/<%= v.id %>"><span><span class="reg sm"><%= v.reg %></span> <%= [v.make, v.model].filter(Boolean).join(' ') %></span><%- pill(v.mot.level === 'overdue' || v.tax.level === 'overdue' ? { level: 'overdue', text: 'Overdue' } : { level: 'ok', text: 'MOT ' + (v.mot.due ? ukDate(v.mot.due) : '—') }) %></a><% } %>
        <% if (!myVehicles.length) { %><div class="row-muted"><span class="muted">No vehicle assigned</span></div><% } %>
        <% for (const c of myCards) { %><a href="/fuel/new"><span><%= c.provider %><%= c.card_ref ? ' #' + c.card_ref : '' %> <span class="muted">···· <%= c.last4 || '' %></span></span><%- c.expiryStatus && c.expiryStatus.due ? pill(c.expiryStatus) : '<span class="pill none">No expiry</span>' %></a><% } %>
        <% if (!myCards.length) { %><div class="row-muted"><span class="muted">No fuel card assigned</span></div><% } %>
      </div>
    </div>
    <% } else { %>
    <div class="card">
      <div class="card-head"><h2>Fuel</h2><a class="small" href="/fuel">Fuel Logs →</a></div>
      <% const cMax = Math.max(1000, ...months.map((m) => m.litres)) * 1.18;
         const cW = 300;
         const cH = 112;
         const cTop = 6;
         const cBot = 22;
         const cBw = 30;
         const cStep = cW / months.length;
         const cy = (v) => cTop + (cH - cTop - cBot) * (1 - v / cMax); %>
      <svg class="fuel-chart" viewBox="0 0 <%= cW %> <%= cH %>" role="img" aria-label="Litres of fuel used per month, last 6 months">
        <% for (const g of [0, 0.5, 1]) { %><line x1="0" x2="<%= cW %>" y1="<%= cy(cMax * g / 1.18) %>" y2="<%= cy(cMax * g / 1.18) %>" stroke="#e3e8ef"/><% } %>
        <% months.forEach((m, i) => { const x = i * cStep + (cStep - cBw) / 2; const last = i === months.length - 1; %>
        <rect x="<%= x %>" y="<%= cy(m.litres) %>" width="<%= cBw %>" height="<%= cy(0) - cy(m.litres) %>" rx="4" fill="<%= last ? '#01024c' : '#c9cae3' %>"><title><%= m.label %>: <%= num(m.litres) %> L</title></rect>
        <text x="<%= x + cBw / 2 %>" y="<%= cH - 6 %>" text-anchor="middle" class="ax"><%= m.label %></text>
        <% if (last) { %><text x="<%= x + cBw / 2 %>" y="<%= cy(m.litres) - 5 %>" text-anchor="middle" class="val"><%= num(m.litres) %> L</text><% } %>
        <% }) %>
      </svg>
      <p class="small muted" style="margin:6px 0 0">Litres used, last 6 months · <%= money(months[months.length - 1].cost) %> spent this month</p>
    </div>
    <% } %>
    <div class="card flush">
      <h2>Checks</h2>
      <div class="today-list">
        <a href="<%= manager ? '/checks/vehicle/new' : '/checks?type=vehicle' %>"><span>Walk-arounds today</span><span class="pill <%= stats.walkaroundsDone >= stats.walkaroundsExpected ? 'ok' : 'soon' %>"><%= stats.walkaroundsDone %> / <%= stats.walkaroundsExpected %></span></a>
        <a href="<%= manager ? '/checks/plant/new' : '/checks?type=plant' %>"><span>Plant check sheets this week</span><span class="pill <%= stats.checksWeek >= stats.checksExpected ? 'ok' : 'soon' %>"><%= stats.checksWeek %> / <%= stats.checksExpected %></span></a>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
