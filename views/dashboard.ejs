<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Dashboard</h1><p class="muted" style="margin:0"><%= ukDate(today) %> · <%= stats.plantTotal %> plant · <%= stats.vehicleTotal %> vehicles</p></div>
</div>
<%- include('partials/pane-end') %>
<div class="kpis kpis-4">
  <a class="kpi <%= stats.unsafe ? 'bad' : 'good' %>" href="/defects"><div class="label">Unsafe defects</div><div class="value"><%= stats.unsafe %></div>
    <div class="sub"><%= stats.unsafe ? 'do not use until fixed' : 'none reported' %></div></a>
  <a class="kpi <%= stats.overdue ? 'bad' : 'good' %>" href="#todo" data-goto="overdue"><div class="label">Overdue</div><div class="value"><%= stats.overdue %></div>
    <div class="sub">services, inspections, MOT, tax, checks</div></a>
  <a class="kpi <%= stats.dueSoon ? 'warn' : 'good' %>" href="#todo" data-goto="soon"><div class="label">Coming up</div><div class="value"><%= stats.dueSoon %></div>
    <div class="sub">due in the next 30 days</div></a>
  <a class="kpi <%= stats.receipts ? 'warn' : 'good' %>" href="/fuel/log?show=unverified&period=year"><div class="label">Receipts to check</div><div class="value"><%= stats.receipts %></div>
    <div class="sub"><%= stats.receiptsCost ? money(stats.receiptsCost) + ' waiting for the office' : 'waiting for the office' %></div></a>
</div>

<div class="dash-grid">
  <div class="card flush todo" id="todo">
    <%
      // Tabs: open defects, anything overdue, and what falls due in the next 30 days. Each list scrolls inside the card.
      const tabOf = (t) => t.tab;
      const TABS = [['defects', 'Defects', 'No open defects.'], ['overdue', 'Overdue', 'Nothing overdue.'], ['soon', 'Coming up', 'Nothing due in the next 30 days.']];
      const firstTab = (TABS.find(([k]) => todo.some((t) => tabOf(t) === k)) || TABS[0])[0];
    %>
    <div class="card-head todo-head"><h2>To do</h2>
      <div class="seg-tabs" role="tablist">
        <% for (const [k, label] of TABS) { const n = todo.filter((t) => tabOf(t) === k).reduce((sum, t) => sum + t.count, 0); %>
        <button type="button" role="tab" data-tab="<%= k %>" aria-selected="<%= k === firstTab %>"><%= label %> <span class="n"><%= n %></span></button>
        <% } %>
        <button type="button" role="tab" data-tab="calendar" aria-selected="false">Calendar</button>
      </div>
    </div>
    <% for (const [k, , empty] of TABS) { const rows = todo.filter((t) => tabOf(t) === k); %>
    <div class="todo-scroll" data-panel="<%= k %>" <%= k === firstTab ? '' : 'hidden' %>>
    <% if (!rows.length) { %><p class="empty"><%= empty %> 👍</p><% } else { %>
    <ul>
      <% for (const t of rows) { %>
      <li class="lv-<%= t.level %>">
        <div class="todo-main">
          <a class="todo-title" href="<%= t.href %>"><% if (t.reg) { %><span class="reg sm"><%= t.reg %></span> <% } %><%= t.title %></a>
          <div class="todo-detail"><%= t.detail %></div>
        </div>
        <a class="btn small <%= t.primary ? 'primary' : '' %>" href="<%= t.href %>"><%= t.action %></a>
      </li>
      <% } %>
    </ul>
    <% } %>
    </div>
    <% } %>
    <div class="todo-scroll cal" data-panel="calendar" hidden>
      <div class="cal-bar"><button type="button" class="cal-nav" id="cal-prev" aria-label="Previous month">‹</button><b id="cal-title"></b><button type="button" class="cal-nav" id="cal-next" aria-label="Next month">›</button><button type="button" class="linkbtn small" id="cal-today">Today</button></div>
      <div class="cal-grid" id="cal-grid"></div>
      <div class="cal-day" id="cal-day"></div>
    </div>
    <script type="application/json" id="cal-data"><%- JSON.stringify(calendar).replace(/</g, '\\u003c') %></script>
  </div>
  <script>
    (function () {
      const tabs = document.querySelectorAll('#todo [data-tab]');
      const show = (k) => {
        tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === k)));
        document.querySelectorAll('#todo [data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== k; });
      };
      tabs.forEach((b) => b.addEventListener('click', () => { show(b.dataset.tab); fit(); }));
      // The Overdue and Coming up tiles open their tab.
      document.querySelectorAll('[data-goto]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); show(a.dataset.goto); fit(); }));
      // On a computer screen the page fits the window: the To do list takes the space left and scrolls inside itself.
      function fit() {
        const panels = document.querySelectorAll('#todo [data-panel]');
        panels.forEach((p) => { p.style.maxHeight = ''; });
        if (window.innerWidth <= 1100) return;
        const open = [...panels].find((p) => !p.hidden);
        if (!open) return;
        const spare = document.documentElement.scrollHeight - window.innerHeight;
        const h = open.getBoundingClientRect().height - spare;
        panels.forEach((p) => { p.style.maxHeight = Math.max(220, h) + 'px'; });
      }
      // Calendar: a month grid of due dates. Past dates show red, the next 30 days amber; click a day to list it.
      const events = JSON.parse(document.getElementById('cal-data').textContent);
      const today = new Date().toISOString().slice(0, 10);
      const soon = new Date(Date.now() + 30 * 864e5).toISOString().slice(0, 10);
      const pad = (n) => String(n).padStart(2, '0');
      const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const tone = (d) => (d < today ? 'bad' : d <= soon ? 'warn' : 'ok');
      let ym = today.slice(0, 7);
      let picked = today;
      function dayList(d) {
        const list = events.filter((e) => e.d === d);
        const nice = new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        document.getElementById('cal-day').innerHTML = `<div class="todo-group">${nice}</div>` + (list.length
          ? '<ul>' + list.map((e) => `<li class="lv-${tone(e.d)}"><div class="todo-main"><a class="todo-title" href="${esc(e.h)}">${e.r ? `<span class="reg sm">${esc(e.r)}</span> ` : ''}${esc(e.t)}</a><div class="todo-detail">${esc(e.k)}</div></div><a class="btn small" href="${esc(e.h)}">Open</a></li>`).join('') + '</ul>'
          : '<p class="empty">Nothing due on this day.</p>');
      }
      function draw() {
        const [y, m] = ym.split('-').map(Number);
        document.getElementById('cal-title').textContent = new Date(Date.UTC(y, m - 1, 15)).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
        const first = (new Date(Date.UTC(y, m - 1, 1)).getUTCDay() + 6) % 7;
        const days = new Date(Date.UTC(y, m, 0)).getUTCDate();
        let html = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((d) => `<div class="cal-dow">${d}</div>`).join('');
        for (let i = 0; i < first; i++) html += '<div class="cal-cell blank"></div>';
        for (let n = 1; n <= days; n++) {
          const d = `${ym}-${pad(n)}`;
          const list = events.filter((e) => e.d === d);
          html += `<button type="button" class="cal-cell${d === today ? ' today' : ''}${d === picked ? ' picked' : ''}" data-d="${d}"><span class="cal-n">${n}</span>`
            + list.slice(0, 2).map((e) => `<span class="cal-ev ${tone(d)}" title="${esc(e.k)}: ${esc(e.r ? e.r + ' ' + e.t : e.t)}">${esc(e.k)} · ${esc(e.r || e.t.split(' · ')[0])}</span>`).join('')
            + (list.length > 2 ? `<span class="cal-more">+${list.length - 2} more</span>` : '') + '</button>';
        }
        const grid = document.getElementById('cal-grid');
        grid.innerHTML = html;
        grid.querySelectorAll('[data-d]').forEach((b) => b.addEventListener('click', () => { picked = b.dataset.d; draw(); }));
        dayList(picked);
      }
      const step = (k) => { const [y, m] = ym.split('-').map(Number); const t = new Date(Date.UTC(y, m - 1 + k, 1)); ym = `${t.getUTCFullYear()}-${pad(t.getUTCMonth() + 1)}`; picked = ym === today.slice(0, 7) ? today : `${ym}-01`; draw(); };
      document.getElementById('cal-prev').addEventListener('click', () => step(-1));
      document.getElementById('cal-next').addEventListener('click', () => step(1));
      document.getElementById('cal-today').addEventListener('click', () => { ym = today.slice(0, 7); picked = today; draw(); });
      draw();
      window.addEventListener('resize', fit);
      fit();
    })();
  </script>

  <div class="dash-side">
    <div class="card">
      <div class="card-head"><h2>Fuel</h2><a class="small" href="/fuel">Fuel Logs →</a></div>
      <% const cMax = Math.max(1000, ...months.map((m) => m.litres)) * 1.18;
         const cW = 300;
         const cH = 112;
         const cTop = 6;
         const cBot = 22;
         const cBw = 30;
         const cStep = cW / months.length;
         const cy = (v) => cTop + (cH - cTop - cBot) * (1 - v / cMax); %>
      <svg class="fuel-chart" viewBox="0 0 <%= cW %> <%= cH %>" role="img" aria-label="Litres of fuel used per month, last 6 months">
        <% for (const g of [0, 0.5, 1]) { %><line x1="0" x2="<%= cW %>" y1="<%= cy(cMax * g / 1.18) %>" y2="<%= cy(cMax * g / 1.18) %>" stroke="#e3e8ef"/><% } %>
        <% months.forEach((m, i) => { const x = i * cStep + (cStep - cBw) / 2; const last = i === months.length - 1; %>
        <rect x="<%= x %>" y="<%= cy(m.litres) %>" width="<%= cBw %>" height="<%= cy(0) - cy(m.litres) %>" rx="4" fill="<%= last ? '#01024c' : '#c9cae3' %>"><title><%= m.label %>: <%= num(m.litres) %> L</title></rect>
        <text x="<%= x + cBw / 2 %>" y="<%= cH - 6 %>" text-anchor="middle" class="ax"><%= m.label %></text>
        <% if (last) { %><text x="<%= x + cBw / 2 %>" y="<%= cy(m.litres) - 5 %>" text-anchor="middle" class="val"><%= num(m.litres) %> L</text><% } %>
        <% }) %>
      </svg>
      <p class="small muted" style="margin:6px 0 0">Litres used, last 6 months · <%= money(months[months.length - 1].cost) %> spent this month</p>
    </div>
    <div class="card flush">
      <h2>Today</h2>
      <div class="today-list">
        <a href="/checks?type=vehicle"><span>Walk-arounds done</span><span class="pill <%= stats.walkaroundsDone >= stats.walkaroundsExpected ? 'ok' : 'soon' %>"><%= stats.walkaroundsDone %> / <%= stats.walkaroundsExpected %></span></a>
        <a href="/checks?type=plant"><span>Plant check sheets in date</span><span class="pill <%= stats.checksOk >= stats.checksExpected ? 'ok' : 'soon' %>"><%= stats.checksOk %> / <%= stats.checksExpected %></span></a>
        <a href="/defects"><span>Open defects</span><span class="pill <%= stats.defectsOpen ? 'soon' : 'ok' %>"><%= stats.defectsOpen %></span></a>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
