<%- include('partials/header') %>
<div class="page-head"><div><h1>Log fuel</h1><p class="muted" style="margin:0">Fill in what you put in and snap the receipt. The office adds the price.</p></div></div>
<%- include('partials/pane-end') %>
<% const vOpt = (v) => `${v.reg} – ${[v.make, v.model].filter(Boolean).join(' ')}`; %>
<form class="card lf" method="post" action="/fuel" enctype="multipart/form-data">
  <div class="lf-row lf-top">
    <div class="field">
      <label for="vehicle_id">Vehicle</label>
      <select id="vehicle_id" name="vehicle_id" required>
        <option value="">Choose…</option>
        <% if (mineIds.length) { %><optgroup label="My vehicles"><% for (const v of vehicles.filter((x) => mineIds.includes(x.id))) { %>
          <option value="<%= v.id %>" data-fuel="<%= v.fuel_type %>" <%= selected && selected.id === v.id ? 'selected' : '' %>><%= vOpt(v) %></option>
        <% } %></optgroup><optgroup label="Other vehicles"><% } %>
        <% for (const v of vehicles.filter((x) => !mineIds.includes(x.id))) { %>
          <option value="<%= v.id %>" data-fuel="<%= v.fuel_type %>" <%= selected && selected.id === v.id ? 'selected' : '' %>><%= vOpt(v) %></option>
        <% } %>
        <% if (mineIds.length) { %></optgroup><% } %>
      </select>
    </div>
    <div class="field">
      <label>Fuel</label>
      <span class="seg lf-seg" id="fuel-seg">
        <% for (const t of ['diesel', 'unleaded', 'adblue']) { %>
          <input type="radio" id="ft-<%= t %>" name="fuel_type" value="<%= t %>" required <%= (selected ? selected.fuel_type : 'diesel') === t ? 'checked' : '' %>><label class="<%= t === 'adblue' ? 'na' : 'ok' %>" for="ft-<%= t %>"><%= FUEL_LABELS[t] %></label>
        <% } %>
      </span>
    </div>
  </div>
  <div class="lf-row lf-nums">
    <div class="field"><label for="litres">Litres</label><input id="litres" name="litres" type="number" inputmode="decimal" step="0.01" min="0.01" placeholder="0.00" required></div>
    <div class="field"><label for="mileage">Mileage</label><input id="mileage" name="mileage" type="number" inputmode="numeric" min="0" step="1" placeholder="Odometer"></div>
    <div class="field"><label for="fill_date">Date</label><input id="fill_date" name="fill_date" type="date" value="<%= today %>" max="<%= today %>" required></div>
  </div>
  <% if (myCards.length || otherCards.length) { const cOpt = (c) => [c.provider, c.card_ref ? '#' + c.card_ref : '', c.last4 ? '••' + c.last4 : '', c.reg ? '(' + c.reg + ')' : ''].filter(Boolean).join(' '); %>
  <div class="field">
    <label for="fuel_card_id">Paid with</label>
    <select id="fuel_card_id" name="fuel_card_id">
      <% if (myCards.length) { %><optgroup label="My fuel cards"><% for (const c of myCards) { %>
        <option value="<%= c.id %>" data-vehicle="<%= c.vehicle_id || '' %>" <%= myCards.length === 1 ? 'selected' : '' %>><%= cOpt(c) %></option>
      <% } %></optgroup><% } %>
      <% if (otherCards.length) { %><optgroup label="<%= myCards.length ? 'Other fuel cards' : 'Fuel cards' %>"><% for (const c of otherCards) { %>
        <option value="<%= c.id %>" data-vehicle="<%= c.vehicle_id || '' %>"><%= cOpt(c) %><%= c.holder_display ? ' – ' + c.holder_display : '' %></option>
      <% } %></optgroup><% } %>
      <option value="" <%= myCards.length === 1 ? '' : 'selected' %>>Not a fuel card / paid another way</option>
    </select>
  </div>
  <% } %>
  <label class="lf-receipt" for="receipt">
    <input id="receipt" name="receipt" type="file" accept="image/*,application/pdf" required>
    <img id="receipt-thumb" alt="" hidden>
    <span class="lf-receipt-text"><strong id="receipt-name">Add receipt photo</strong><span class="hint" id="receipt-hint">Take a photo or choose a file (PDF ok, up to 15 MB)</span></span>
  </label>
  <details class="lf-more">
    <summary>Fuel station and notes <span class="hint">(optional)</span></summary>
    <div class="field"><label for="station">Fuel station</label><input id="station" name="station" type="text"></div>
    <div class="field"><label for="notes">Notes</label><textarea id="notes" name="notes" style="min-height:60px"></textarea></div>
  </details>
  <button class="btn primary big" type="submit">Save fuel entry</button>
</form>
<script>
  const vehicle = document.getElementById('vehicle_id');
  const card = document.getElementById('fuel_card_id');
  // Preselect the fuel card linked to the chosen vehicle, if there is one.
  function pickCard() {
    if (!card) return;
    const linked = [...card.options].find((o) => o.dataset.vehicle && o.dataset.vehicle === vehicle.value);
    const cur = card.selectedOptions[0];
    if (linked) linked.selected = true;
    // Don't carry over a card that belongs to a different vehicle.
    else if (cur && cur.dataset.vehicle && cur.dataset.vehicle !== vehicle.value) card.value = '';
  }
  pickCard();
  vehicle.addEventListener('change', function () {
    pickCard();
    const opt = this.selectedOptions[0];
    const fuel = opt && opt.dataset.fuel;
    if (fuel && !document.getElementById('ft-adblue').checked) document.getElementById('ft-' + fuel).checked = true;
  });
  document.getElementById('receipt').addEventListener('change', function () {
    const f = this.files[0];
    const thumb = document.getElementById('receipt-thumb');
    this.closest('.lf-receipt').classList.toggle('done', !!f);
    document.getElementById('receipt-name').textContent = f ? f.name : 'Add receipt photo';
    document.getElementById('receipt-hint').textContent = f ? 'Tap to change' : 'Take a photo or choose a file (PDF ok, up to 15 MB)';
    if (f && f.type.startsWith('image/')) { thumb.src = URL.createObjectURL(f); thumb.hidden = false; } else thumb.hidden = true;
  });
</script>
<%- include('partials/footer') %>
