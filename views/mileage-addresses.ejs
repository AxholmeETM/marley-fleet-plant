<%- include('partials/header') %>
<%
  const works = places.filter((x) => x.kind === 'work').sort((a, b) => (a.label || a.address).localeCompare(b.label || b.address));
  const homes = places.filter((x) => x.kind === 'home').sort((a, b) => (a.user_name || '').localeCompare(b.user_name || ''));
  const unknowns = places.filter((x) => x.kind === 'unknown');
  const stops = places.filter((x) => x.kind === 'stop').sort((a, b) => (a.label || a.address).localeCompare(b.label || b.address));
  const TABS = [['sort', 'To sort', unsaved.length], ['work', 'Sites', works.length], ['stop', 'Allowed stops', stops.length], ['home', 'Homes', homes.length], ['unknown', 'Unknown', unknowns.length]];
  const mapUrl = (a) => 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(a);
  const placeJson = (x) => JSON.stringify({ id: x.id, kind: x.kind, user_id: x.user_id, label: x.label, address: x.address });
  const names = (ds) => (ds.length > 2 ? `${ds.slice(0, 2).map((d) => d.name).join(', ')} +${ds.length - 2}` : ds.map((d) => d.name).join(', ')) || '—';
%>
<div class="page-head">
  <div><h1>Addresses</h1>
  <p class="muted" style="margin:0">Save sites, allowed stops and drivers' homes so each trip can be marked as work or personal.</p></div>
  <% if (canEdit) { %><div class="actions"><button class="btn primary" type="button" data-add="<%= JSON.stringify({ kind: ['home', 'unknown', 'stop'].includes(show) ? show : 'work' }) %>">Add address</button></div><% } %>
</div>
<%- include('partials/pane-end') %>
<div class="card mi-addr">
  <div class="mi-addr-head">
    <nav class="subnav" aria-label="Address lists"><% for (const [key, label, n] of TABS) { %><a href="/mileage/addresses?<%= qs %>&show=<%= key %>" class="mi-tab-<%= key %><%= show === key ? ' active' : '' %>"><%= label %> <span class="count"><%= n %></span></a><% } %></nav>
    <input type="search" class="pick-filter" id="addr-filter" placeholder="Find an address or name" aria-label="Find an address or name">
  </div>

  <% if (show === 'sort') { %>
  <section data-list="sort">
    <p class="muted small mi-addr-intro">Addresses from the trips <%= ukDate(p.from) %> to <%= ukDate(p.to) %> that aren't saved yet, most likely sites first. <span class="mi-tag site">Site?</span> means a vehicle stopped there 3 hours or more on a weekday. To use another week, pick it on the <a href="/mileage?<%= qs %>">Dashboard</a>.</p>
    <% if (!unsaved.length) { %><p class="empty">Every address in these trips is saved.</p><% } else { %>
    <div class="table-wrap"><table class="mi-addr-table">
      <thead><tr><th class="desc">Address</th><th class="num">Visits</th><th>Drivers</th><% if (canEdit) { %><th></th><% } %></tr></thead>
      <tbody><% for (const a of unsaved) { %>
        <tr>
          <td class="desc"><% if (a.site) { %><span class="mi-tag site">Site?</span><% } %><a href="<%= mapUrl(a.address) %>" target="_blank" rel="noopener" title="See location in Google Maps"><%= a.address %></a></td>
          <td class="num"><%= a.visits %></td>
          <td class="small" title="<%= a.drivers.map((d) => d.name).join(', ') %>"><%= names(a.drivers) %></td>
          <% if (canEdit) { %><td class="num nowrap"><form method="post" action="/mileage/addresses" class="mi-quick">
            <input type="hidden" name="address" value="<%= a.address %>"><input type="hidden" name="back" value="<%= back %>">
            <button class="btn small mi-kind work" type="submit" name="kind" value="work">Site</button>
            <button class="btn small mi-kind stop" type="submit" name="kind" value="stop">Stop</button>
            <button class="btn small mi-kind home" type="button" data-add="<%= JSON.stringify({ address: a.address, kind: 'home', user_id: a.drivers.length === 1 ? a.drivers[0].id : null }) %>">Home</button>
            <button class="btn small mi-kind unknown" type="submit" name="kind" value="unknown">Unknown</button>
          </form></td><% } %>
        </tr>
      <% } %></tbody>
    </table></div>
    <% } %>
  </section>
  <% } else if (show === 'work') { %>
  <section data-list="work">
    <p class="muted small mi-addr-intro">Sites where we're working. A journey that reaches one of these counts as work.</p>
    <% if (!works.length) { %><p class="empty">No sites yet.</p><% } else { %>
    <div class="table-wrap"><table class="mi-addr-table">
      <thead><tr><th>Name</th><th class="desc">Address</th><% if (canEdit) { %><th></th><% } %></tr></thead>
      <tbody><% for (const w of works) { %>
        <tr><td><strong><%= w.label || '—' %></strong></td>
          <td class="desc"><a href="<%= mapUrl(w.address) %>" target="_blank" rel="noopener" title="See location in Google Maps"><%= w.address %></a></td>
          <% if (canEdit) { %><td class="num"><button class="btn small" type="button" data-place="<%= placeJson(w) %>">Edit</button></td><% } %></tr>
      <% } %></tbody>
    </table></div>
    <% } %>
  </section>
  <% } else if (show === 'stop') { %>
  <section data-list="stop">
    <p class="muted small mi-addr-intro">Fuel stations, lunch spots and suppliers. A stop doesn't make a trip work or personal: it counts as whatever the rest of the journey is.</p>
    <% if (!stops.length) { %><p class="empty">No allowed stops yet.</p><% } else { %>
    <div class="table-wrap"><table class="mi-addr-table">
      <thead><tr><th>Name</th><th class="desc">Address</th><% if (canEdit) { %><th></th><% } %></tr></thead>
      <tbody><% for (const w of stops) { %>
        <tr><td><strong><%= w.label || '—' %></strong></td>
          <td class="desc"><a href="<%= mapUrl(w.address) %>" target="_blank" rel="noopener" title="See location in Google Maps"><%= w.address %></a></td>
          <% if (canEdit) { %><td class="num"><button class="btn small" type="button" data-place="<%= placeJson(w) %>">Edit</button></td><% } %></tr>
      <% } %></tbody>
    </table></div>
    <% } %>
  </section>
  <% } else if (show === 'home') { %>
  <section data-list="home">
    <p class="muted small mi-addr-intro">Where each driver lives. A journey from home that never reaches a site counts as personal.</p>
    <% if (!homes.length) { %><p class="empty">No home addresses yet.</p><% } else { %>
    <div class="table-wrap"><table class="mi-addr-table">
      <thead><tr><th>Employee</th><th class="desc">Address</th><% if (canEdit) { %><th></th><% } %></tr></thead>
      <tbody><% for (const h of homes) { %>
        <tr><td><strong><%= h.user_name || '—' %></strong></td>
          <td class="desc"><a href="<%= mapUrl(h.address) %>" target="_blank" rel="noopener" title="See location in Google Maps"><%= h.address %></a></td>
          <% if (canEdit) { %><td class="num"><button class="btn small" type="button" data-place="<%= placeJson(h) %>">Edit</button></td><% } %></tr>
      <% } %></tbody>
    </table></div>
    <% } %>
  </section>
  <% } else { %>
  <section data-list="unknown">
    <p class="muted small mi-addr-intro">Places nobody is sure about yet. Trips to or from them count as personal until you ask the driver and change them to work or a home.</p>
    <% if (!unknowns.length) { %><p class="empty">No unknown addresses.</p><% } else { %>
    <div class="table-wrap"><table class="mi-addr-table">
      <thead><tr><th>Note</th><th class="desc">Address</th><% if (canEdit) { %><th></th><% } %></tr></thead>
      <tbody><% for (const u of unknowns) { %>
        <tr><td><strong><%= u.label || '—' %></strong></td>
          <td class="desc"><a href="<%= mapUrl(u.address) %>" target="_blank" rel="noopener" title="See location in Google Maps"><%= u.address %></a></td>
          <% if (canEdit) { %><td class="num"><button class="btn small" type="button" data-place="<%= placeJson(u) %>">Edit</button></td><% } %></tr>
      <% } %></tbody>
    </table></div>
    <% } %>
  </section>
  <% } %>
</div>
<script>
  document.getElementById('addr-filter').addEventListener('input', (e) => {
    const q = e.target.value.trim().toLowerCase();
    document.querySelectorAll('.mi-addr-table tbody tr').forEach((tr) => { tr.hidden = q && !tr.textContent.toLowerCase().includes(q); });
  });
</script>
<%- include('partials/mileage-add-dlg') %>
<%- include('partials/mileage-place-dlg') %>
<%- include('partials/footer') %>
