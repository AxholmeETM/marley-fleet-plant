<%- include('partials/header') %>
<div class="page-head"><div><h1>Admin</h1><p class="muted" style="margin:0">Employees and projects.</p></div></div>
<%- include('partials/pane-end') %>
<div class="tiles">
  <a class="tile" href="/users">
    <span class="tile-title">Employees</span>
    <span class="tile-value"><%= (users.admins || 0) + (users.drivers || 0) + (users.site_managers || 0) %></span>
    <span class="tile-sub"><%= users.drivers || 0 %> fleet drivers · <%= users.site_managers || 0 %> site managers · <%= users.admins || 0 %> admin</span>
  </a>
  <a class="tile" href="/projects">
    <span class="tile-title">Projects</span>
    <span class="tile-value"><%= projects %></span>
    <span class="tile-sub">open project numbers</span>
  </a>
</div>
<div class="grid grid-2">
  <div class="card">
    <h2>Add people</h2>
    <p class="muted small" style="margin-top:0">Employees sign in with the email and password you set, and only see what their type allows.</p>
    <div class="actions" style="display:flex;gap:8px;flex-wrap:wrap">
      <a class="btn primary" href="/users/new?type=driver">Add fleet driver</a>
      <a class="btn" href="/users/new?type=site_manager">Add site manager</a>
      <a class="btn" href="/users/new?role=admin">Add admin user</a>
    </div>
  </div>
  <div class="card">
    <h2>Who can see what</h2>
    <dl class="facts">
      <dt>Admin users</dt><dd>Everything: plant, equipment, fleet, fuel cards and receipts, and users.</dd>
      <dt>Site managers</dt><dd>All plant and equipment: view records, do check sheets, report defects and record services and inspections. Plus their own vehicles: walk-arounds, fuel and defects. They don't see purchase prices or hire rates.</dd>
      <dt>Fleet drivers</dt><dd>Only the vehicles assigned to them: walk-around checks, fuel logs with their fuel cards, and defects.</dd>
    </dl>
  </div>
</div>
<%- include('partials/footer') %>
