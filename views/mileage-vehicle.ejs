<%- include('partials/header') %>
<%
  const TAGS = { home: 'Home', work: 'Site', unknown: 'Unknown', stop: 'Stop' };
  const loc = (where, text, place) => {
    const tag = place && canEdit
      ? `<button type="button" class="mi-tag ${place.kind} mi-edit" title="Change or remove this saved address" data-place="${escapeHtml(JSON.stringify({ id: place.id, kind: place.kind, user_id: place.user_id, label: place.label, address: place.address }))}">${TAGS[place.kind]}</button>`
      : where === 'home' ? '<span class="mi-tag home">Home</span>' : where === 'work' ? '<span class="mi-tag work">Site</span>' : where === 'stop' ? '<span class="mi-tag stop" title="Allowed stop: counts as the rest of the journey">Stop</span>' : where === 'unknown' ? '<span class="mi-tag unknown" title="Saved as unknown: counts as personal">Unknown</span>' : where === 'site' ? '<span class="mi-tag site" title="Stopped here 3 hours or more on a weekday, so taken as a site. Click + to save it.">Site?</span>' : '';
    const addData = escapeHtml(JSON.stringify({ address: text, user_id: v.driver_id }));
    // The tag is a square block beside the address; an address not saved yet gets a + block in its place.
    const block = tag || (text && canEdit && !where ? `<button class="mi-tag none mi-add" type="button" data-add="${addData}" title="Save this address">+</button>` : '<span class="mi-tag none"></span>');
    const add = where === 'site' && text && canEdit ? ` <button class="mi-add" type="button" data-add="${addData}" title="Save this address">+</button>` : '';
    return `<div class="mi-loc">${block}<span>${escapeHtml(text || '—')}${add}</span></div>`;
  };
%>
<div class="page-head">
  <div><h1><%= v.driver_name || v.device %> <span class="reg"><%= v.regText %></span></h1>
    <p class="muted" style="margin:0"><%= ukDate(p.from) %> to <%= ukDate(p.to) %> · <strong><%= M.fmtMiles(v.work) %></strong> work miles · <strong class="mi-personal"><%= M.fmtMiles(v.personal) %></strong> personal miles<% if (v.notOnFleet) { %> · not on the Fleet register<% } %></p></div>
  <div class="actions"><span class="mi-check-box<%= v.checked ? ' done' : '' %>"><%- include('partials/mileage-check', { v, back, showLabel: true }) %></span><a class="btn" href="/mileage/addresses?<%= qs %>">Addresses</a><a class="btn" href="/reports/mileage?<%= qs %>&reg=<%= v.reg %>&print=1" target="_blank" rel="noopener">Print</a></div>
</div>
<% if (v.needsHome) { %><div class="flash warning">No home address for <%= v.driver_name %> yet, so every trip counts as work. Click <strong>+</strong> next to their home on a trip below, or add it under Addresses.</div><% } %>
<% if (!v.driver_id && !v.notOnFleet) { %><div class="flash warning">This vehicle has no driver on the Fleet register, so every trip counts as work.</div><% } %>
<%- include('partials/pane-end') %>
<div class="card flush">
  <div class="table-wrap"><table class="mi-trips">
    <thead><tr><th>Start</th><th class="desc">From</th><th>End</th><th class="desc">To</th><th class="num">Miles</th><th class="num">Trip time</th><th class="num">Idle</th><th>Counts as</th><th>See trip</th></tr></thead>
    <% for (const d of days) { const dm = d.trips; %>
    <tbody>
      <tr class="group"><th colspan="9"><%= new Date(d.date + 'T12:00:00Z').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }) %>
        <span><%= M.fmtMiles(M.sum(dm, 'work')) %> work<% if (M.sum(dm, 'personal')) { %> · <%= M.fmtMiles(M.sum(dm, 'personal')) %> personal<% } %></span></th></tr>
      <% for (const t of dm) { %>
      <tr id="trip-<%= t.id %>" class="<%= t.use === 'personal' ? 'mi-row-personal' : '' %>">
        <td class="nowrap"><%= t.started_at.slice(11, 16) %></td>
        <td><%- loc(t.from, t.start_loc, t.fromPlace) %></td>
        <td class="nowrap"><%= t.ended_at ? t.ended_at.slice(11, 16) : '—' %></td>
        <td><%- loc(t.to, t.end_loc, t.toPlace) %></td>
        <td class="num"><%= M.fmtMiles(t.distance) %></td>
        <td class="num"><%= M.fmtSecs(t.trip_secs) %></td>
        <td class="num"><%= t.idle_secs ? M.fmtSecs(t.idle_secs) : '—' %></td>
        <td class="nowrap">
          <% if (canEdit) { %><form method="post" action="/mileage/trips/<%= t.id %>" class="mi-use">
            <input type="hidden" name="back" value="<%= back %>">
            <button class="pill <%= t.use === 'personal' ? 'soon' : 'ok' %>" type="submit" name="use" value="<%= t.use === 'personal' ? 'work' : 'personal' %>" title="Change to <%= t.use === 'personal' ? 'work' : 'personal' %>"><%= t.use === 'personal' ? 'Personal' : 'Work' %></button>
            <% if (t.override) { %><button class="linkbtn small" type="submit" name="use" value="" title="Go back to how it was worked out (<%= t.auto %>)">Undo</button><% } %>
          </form><% } else { %><span class="pill <%= t.use === 'personal' ? 'soon' : 'ok' %>"><%= t.use === 'personal' ? 'Personal' : 'Work' %></span><% } %>
        </td>
        <td class="nowrap"><% if (t.start_loc && t.end_loc) { %><a class="btn small" href="https://www.google.com/maps/dir/?api=1&origin=<%= encodeURIComponent(M.postcodeOf(t.start_loc)) %>&destination=<%= encodeURIComponent(M.postcodeOf(t.end_loc)) %>&travelmode=driving" target="_blank" rel="noopener" title="Open the route from start to end in Google Maps">See trip</a><% } %></td>
      </tr>
      <% } %>
    </tbody>
    <% } %>
  </table></div>
</div>
<div class="card mi-key">
  <div>
    <h3>What the tags mean</h3>
    <dl>
      <dt><span class="mi-tag home">Home</span></dt><dd>The driver's home.</dd>
      <dt><span class="mi-tag work">Site</span></dt><dd>A site. A journey that reaches one counts as work.</dd>
      <dt><span class="mi-tag stop">Stop</span></dt><dd>Fuel, lunch or a supplier. Counts as the rest of its journey.</dd>
      <dt><span class="mi-tag unknown">Unknown</span></dt><dd>Not sure yet. Counts as personal until you ask the driver.</dd>
      <dt><span class="mi-tag site">Site?</span></dt><dd>A weekday stop of 3 hours or more that isn't saved yet, so taken as a site.</dd>
    </dl>
  </div>
  <div>
    <h3>How to use this page</h3>
    <ul>
      <li>Click a tag to change or remove that saved address.</li>
      <li>Click <strong>+</strong> next to any other address to save it as a site, a stop, a home or unknown.</li>
      <li>Click Work or Personal on a trip to change just that trip; Undo puts it back.</li>
      <li>See trip opens the route in Google Maps.</li>
    </ul>
  </div>
</div>
<%- include('partials/mileage-add-dlg') %>
<%- include('partials/mileage-place-dlg') %>
<%- include('partials/footer') %>
